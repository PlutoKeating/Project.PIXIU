  "samples": [
    {
      "shot": "s01",
      "frame": 43,
      "text": "面向麒麟操作系统智能体的去中心化记忆系统。"
    },
    {
      "shot": "s02",
      "frame": 425,
      "text": "貔貅连接设备之间的知识与经验，"
    },
    {
      "shot": "s03",
      "frame": 683,
      "text": "连接成可信设备之间的集体记忆网络。"
    },
    {
      "shot": "s04",
      "frame": 1252,
      "text": "以及系统向量化和向量数据库的实际运行状态。"
    },
    {
      "shot": "s05",
      "frame": 1597,
      "text": "把它连接到貔貅的接入、检索、安全和分布式同步引擎。"
    },
    {
      "shot": "s06",
      "frame": 1880,
      "text": "这里展示采购复核单的处理过程。"
    },
    {
      "shot": "s07",
      "frame": 2208,
      "text": "以家庭账单为例：电费二百一十元，"
    },
    {
      "shot": "s08",
      "frame": 2604,
      "text": "合计四百三十四元五角。"
    },
    {
      "shot": "s09",
      "frame": 3102,
      "text": "接入时进行格式校验、清洗、质量评估和敏感检测，"
    },
    {
      "shot": "s10",
      "frame": 3607,
      "text": "保存后可以马上检索和核对正文。"
    },
    {
      "shot": "s11",
      "frame": 4016,
      "text": "还能在来源区查看文件路径与采集时间。"
    },
    {
      "shot": "s12",
      "frame": 4256,
      "text": "这里的记录保留了应用名称和使用时长。"
    },
    {
      "shot": "s13",
      "frame": 4611,
      "text": "系统把关键词、语义和关联信息结合起来，"
    },
    {
      "shot": "s14",
      "frame": 5036,
      "text": "这里记录了书架位置、图书归还步骤、分类调整经验，"
    },
    {
      "shot": "s15",
      "frame": 5551,
      "text": "偏好记忆关注操作习惯、输出风格和安全策略。"
    },
    {
      "shot": "s16",
      "frame": 6155,
      "text": "编辑基于读取时的版本：如果另一端已经更新，"
    },
    {
      "shot": "s17",
      "frame": 6795,
      "text": "检索时只注入预算内的相关记忆，"
    },
    {
      "shot": "s18",
      "frame": 6959,
      "text": "看貔貅最关键的能力：让多台设备上的智能体，"
    },
    {
      "shot": "s19",
      "frame": 7395,
      "text": "把需要协作的电脑连接起来，"
    },
    {
      "shot": "s20",
      "frame": 7579,
      "text": "记下周六上午九点整理书房、书籍按主题分类的约定。"
    },
    {
      "shot": "s21",
      "frame": 8030,
      "text": "用家庭节能约定验证断连恢复。"
    },
    {
      "shot": "s22",
      "frame": 8787,
      "text": "三台设备都读到相同的版本三与同一正文。"
    },
    {
      "shot": "s23",
      "frame": 9048,
      "text": "敏感检测会拦截包含敏感信息的共享写入。"
    },
    {
      "shot": "s24",
      "frame": 9566,
      "text": "共享记忆的删除标记会同步给其他设备，"
    },
    {
      "shot": "s26",
      "frame": 9804,
      "text": "把近期高质量记忆整理为可继续检索的线索，"
    },
    {
      "shot": "s27",
      "frame": 10492,
      "text": "升级过程通过签名校验、健康检查和失败恢复，"
    },
    {
      "shot": "s28",
      "frame": 10764,
      "text": "评测工具分别统计偏好提取、知识召回、检索耗时和"
    },
    {
      "shot": "s29",
      "frame": 11192,
      "text": "面向家庭协作、办公交接和跨设备任务，"
    },
    {
      "shot": "s30",
      "frame": 11509,
      "text": "面向麒麟操作系统智能体，"
    }
  ]
}
