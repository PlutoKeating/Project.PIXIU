/* PIXIU 全局样式：颜色全部使用 palette 角色（语义色由 UiTokens 生成，
   明暗主题切换随 Palette 联动）；禁止在 QSS 中硬编码颜色。
   2026-08-10 侧边浮窗视觉统一：弱边框、圆角、卡片感、低噪声；
   字号分级与间距/圆角见 frontend/docs/ARCHITECTURE.md §7。 */

QWidget {
    font-size: 11pt;
}

/* ── 通用按钮：柔和填充、无硬边框、圆角 ─────────────────── */
QPushButton {
    background-color: palette(button);
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    color: palette(button-text);
}
QPushButton:hover {
    background-color: palette(alternate-base);
}
QPushButton:pressed {
    background-color: palette(midlight);
}
QPushButton:disabled {
    color: palette(mid);
    background-color: palette(window);
}
QPushButton:focus {
    border: 1px solid palette(highlight);
}
QPushButton:flat {
    background: transparent;
    border: none;
    padding: 6px;
}
QPushButton:flat:hover {
    background-color: palette(alternate-base);
    border-radius: 8px;
}
QPushButton:flat:pressed {
    background-color: palette(midlight);
    border-radius: 8px;
}
QPushButton:flat:focus {
    border: 1px solid palette(highlight);
    border-radius: 8px;
}

/* ── 设置入口按钮：文字色用 palette(text)（而非默认 palette(button-text)）─────
    真机运行日志为 “using Qt default palette”（theme following disabled），此时
    Qt 默认 palette 的 button-text 为暗字，在 UKUI 深色主题背景（kfashion-dark.css）
    上不可读。本仓库 lightPalette()/darkPalette() 中 Text==ButtonText，但那只在
    ThemeService darkPalette 生效时成立；真机 default palette 下两者不同，故改用
    随 palette 更新的 palette(text)（深色下解析为亮色）。hover/pressed/focus 沿用
    上方通用按钮规则。 */
QPushButton#openMonitorCenterButton,
QPushButton#checkUpdateButton,
QPushButton#aboutUsButton,
QPushButton#termsButton,
QPushButton#privacyButton {
    color: palette(text);
}

/* ── 输入控件：浅灰填充、弱边框、大圆角 ─────────────────── */
QLineEdit, QPlainTextEdit, QComboBox, QKeySequenceEdit {
    background-color: palette(alternate-base);
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 7px 12px;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}
QLineEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QKeySequenceEdit:focus {
    background-color: palette(base);
    border-color: palette(highlight);
}
QLineEdit:disabled, QPlainTextEdit:disabled {
    color: palette(mid);
    background-color: palette(window);
}
QComboBox::drop-down {
    border: none;
    width: 22px;
}

/* ── 列表与卡片行：透明底、圆角行、低间距 ───────────────── */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
}
QListWidget::item {
    padding: 8px 10px;
    margin: 3px 0;
    border-radius: 8px;
}
QListWidget::item:hover {
    background-color: palette(alternate-base);
}
QListWidget::item:selected {
    background: transparent;
}
/* 消息流不套卡片行样式（气泡自带底色）。 */
QListWidget#messageList {
    background: transparent;
    border: none;
}
QListWidget#messageList::item {
    padding: 2px 0;
    margin: 0;
    border-radius: 0;
    background: transparent;
}

/* ── 滚动条：细、透明轨道、圆角滑块 ─────────────────────── */
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: palette(mid);
    border-radius: 2px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: palette(midlight);
}
QScrollBar:horizontal {
    background: transparent;
    height: 5px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: palette(mid);
    border-radius: 2px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: palette(midlight);
}
QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ── Tab：无边框内容区、胶囊选中态 ───────────────────────── */
QTabWidget::pane {
    border: none;
    top: 0;
}
QTabBar {
    background: transparent;
}
QTabBar::tab {
    background: transparent;
    padding: 7px 16px;
    border-radius: 8px;
    font-size: 11pt;
}
QTabBar::tab:hover {
    background-color: palette(alternate-base);
}
QTabBar::tab:selected {
    background-color: palette(alternate-base);
    color: palette(highlight);
    font-weight: bold;
}

/* ── 菜单与提示 ─────────────────────────────────────────── */
QMenu {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 7px 18px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: palette(highlight);
    color: palette(highlighted-text);
}
QToolTip {
    background-color: palette(tooltip-base);
    color: palette(tooltip-text);
    border: 1px solid palette(mid);
    border-radius: 6px;
    padding: 4px 10px;
}

/* ── 对话框底：与浮窗同底色，内容留白 ───────────────────── */
QDialog {
    background-color: palette(window);
}

/* ── 标题与顶栏（ARCHITECTURE §7.2：标题 14pt）────────────── */
QLabel#titleLabel,
QLabel#panelTitleLabel,
QLabel#prefHeaderLabel,
QLabel#settingsTitleLabel {
    font-size: 14pt;
    font-weight: bold;
}
QLabel#syncStatusLabel,
QLabel#pairStatusLabel,
QLabel#syncSummaryLabel {
    font-size: 11pt;
}
QLabel#versionLabel {
    color: palette(mid);
    font-size: 9pt;
}

/* ── 聊天输入区：chip 快捷行 + 圆角输入卡片 ─────────────── */
QWidget#inputBar {
    background: transparent;
}
QWidget#inputCard {
    background-color: palette(alternate-base);
    border: 1px solid palette(midlight);
    border-radius: 14px;
}
QPlainTextEdit#inputEdit {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 6px 4px;
    font-size: 11pt;
}
QPlainTextEdit#inputEdit:focus {
    background: transparent;
    border: none;
}
QPlainTextEdit#inputEdit:disabled {
    color: palette(mid);
    background: transparent;
}
QLabel#inputStateBadge {
    font-size: 9pt;
    padding: 2px 2px;
}
QPushButton[chipRole="chip"] {
    background-color: palette(alternate-base);
    border: none;
    border-radius: 12px;
    /* 4 个主 chip + 溢出“更多”在默认 380 宽窗口（内容区 348）必须全部放得下，
       水平内边距取 9px：4×chip + “更多” = 335 ≤ 340，默认宽度不出现重复入口。 */
    padding: 4px 9px;
    font-size: 10pt;
    color: palette(text);
}
QPushButton[chipRole="chip"]:hover {
    background-color: palette(midlight);
}
QPushButton[chipRole="chip"]:pressed {
    background-color: palette(mid);
}
QPushButton[chipRole="chip"]:disabled {
    color: palette(mid);
    background-color: transparent;
}
QPushButton[chipRole="chip"]:focus {
    border: 1px solid palette(highlight);
}

/* ── 消息气泡（§7.2/7.3：内边距 12px，圆角 12/14px）──────── */
QLabel#userBubble {
    background-color: palette(highlight);
    color: palette(highlighted-text);
    border-radius: 14px;
    padding: 10px 14px;
    font-size: 11pt;
}
QLabel#assistantBubble {
    background-color: palette(alternate-base);
    color: palette(text);
    border: none;
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 11pt;
}
QLabel#assistantMeta {
    color: palette(mid);
    font-size: 9pt;
    padding: 0 4px;
}
QLabel#systemHint {
    color: palette(mid);
    font-size: 10pt;
    padding: 2px 8px;
}

/* ── 证据卡（§7.3：内边距 10px，圆角 10px）────────────────── */
QFrame#evidenceCard {
    background-color: palette(base);
    border: 1px solid palette(mid);
    border-radius: 10px;
}
QLabel#evidenceTitle {
    font-size: 10pt;
    font-weight: bold;
    color: palette(text);
}
QLabel#evidenceMeta {
    color: palette(mid);
    font-size: 9pt;
}
QLabel#evidenceAction {
    color: palette(highlight);
    font-size: 9pt;
    font-weight: bold;
}

/* ── 同步 Tab 节点行 ─────────────────────────────────────── */
QLabel#peerNameLabel {
    font-size: 11pt;
    font-weight: bold;
}
QLabel#peerStateLabel,
QLabel#peerMetaLabel {
    color: palette(mid);
    font-size: 9pt;
}

/* ── 加载 / 空 / 错误状态 ─────────────────────────────────── */
QLabel#conflictEmptyLabel,
QLabel#prefEmptyLabel,
QLabel#syncEmptyLabel {
    color: palette(mid);
    font-size: 11pt;
    padding: 16px;
}
QLabel#queryErrorHint,
QLabel#emptyHint {
    font-size: 11pt;
}
QLabel#emptyHint {
    color: palette(mid);
}

/* ── 录入拖入占位框 ───────────────────────────────────────── */
QLabel#previewLabel {
    border: 1px dashed palette(mid);
    border-radius: 10px;
    color: palette(mid);
    font-size: 11pt;
    background-color: palette(base);
}

/* ── 欢迎空态（侧边浮窗首屏）─────────────────────────────── */
QWidget#welcomeView {
    background: transparent;
}
QLabel#welcomeTitle {
    font-size: 16pt;
    font-weight: bold;
    color: palette(text);
}
QLabel#welcomeSubtitle {
    color: palette(mid);
    font-size: 11pt;
}
QLabel#welcomeHint {
    color: palette(mid);
    font-size: 9pt;
}
QLabel#suggestLabel {
    color: palette(mid);
    font-size: 10pt;
    font-weight: bold;
}
QPushButton#suggestionCard {
    background-color: palette(alternate-base);
    border: none;
    border-radius: 10px;
    text-align: left;
    padding: 0;
}
QPushButton#suggestionCard:hover {
    background-color: palette(midlight);
}
QPushButton#suggestionCard:pressed {
    background-color: palette(mid);
}
QPushButton#suggestionCard:focus {
    border: 1px solid palette(highlight);
}
/* 动态洞察卡 / 今日简报卡（B4-3）：镜像 #suggestionCard 规则——这两类卡
   的 objectName 与 #suggestionCard 不同（InsightCard 原生命名、digestCard
   覆写自 SuggestionCard），需独立选择器才有圆角浅灰卡片样式。 */
QPushButton#insightCard {
    background-color: palette(alternate-base);
    border: none;
    border-radius: 10px;
    text-align: left;
    padding: 0;
}
QPushButton#insightCard:hover {
    background-color: palette(midlight);
}
QPushButton#insightCard:pressed {
    background-color: palette(mid);
}
QPushButton#insightCard:focus {
    border: 1px solid palette(highlight);
}
QPushButton#digestCard {
    background-color: palette(alternate-base);
    border: none;
    border-radius: 10px;
    text-align: left;
    padding: 0;
}
QPushButton#digestCard:hover {
    background-color: palette(midlight);
}
QPushButton#digestCard:pressed {
    background-color: palette(mid);
}
QPushButton#digestCard:focus {
    border: 1px solid palette(highlight);
}
QLabel#suggestionText {
    font-size: 11pt;
    color: palette(text);
    background: transparent;
}
QLabel#suggestionIcon {
    background: transparent;
}
QScrollArea#welcomeScroll {
    background: transparent;
    border: none;
}
QScrollArea#welcomeScroll > QWidget > QWidget {
    background: transparent;
}

/* ── 思考骨架屏（加载占位）────────────────────────────────── */
QWidget#thinkingSkeleton {
    background: transparent;
}
