+        const QString status = event.value(QStringLiteral("status")).toString();
+        const QString tool = activityName(event.value(QStringLiteral("tool")).toString());
+        const QString label = event.value(QStringLiteral("label")).toString().trimmed();
+        const QString marker = callId.isEmpty() ? tool : callId;
+        const QString line = QStringLiteral("%1 %2%3")
+            .arg(status == QStringLiteral("completed") ? QStringLiteral("完成") : QStringLiteral("进行中"),
+                 tool,
+                 label.isEmpty() ? QString() : QStringLiteral(" · %1").arg(label));
+        QStringList &lines = m_activityLines[sessionId];
+        int index = -1;
+        for (int i = 0; i < lines.size(); ++i) {
+            if (lines.at(i).startsWith(QStringLiteral("[%1]").arg(marker))) { index = i; break; }
+        }
+        const QString stored = QStringLiteral("[%1] %2").arg(marker, line);
+        if (index >= 0) lines[index] = stored; else lines.append(stored);
+    } else {
+        const QString text = event.value(QStringLiteral("text")).toString().trimmed();
+        m_activityLines[sessionId].append(text.isEmpty() ? QStringLiteral("分支任务正在处理") : text);
