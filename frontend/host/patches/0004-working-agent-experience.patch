+void ChatWidget::ensureActivityCard(const QString &sessionId)
+{
+    if (sessionId != m_currentSessionId || m_activityCards.contains(sessionId)) {
         return;
     }
+    QWidget *card = new QWidget(m_messagesContainer);
+    card->setObjectName(QStringLiteral("activityCard"));
+    card->setMaximumWidth(760);
+    QVBoxLayout *layout = new QVBoxLayout(card);
+    layout->setContentsMargins(14, 10, 14, 10);
+    layout->setSpacing(7);
+    auto *toggle = new QToolButton(card);
+    toggle->setObjectName(QStringLiteral("activityToggle"));
+    toggle->setCheckable(true);
+    toggle->setChecked(false);
+    toggle->setToolButtonStyle(Qt::ToolButtonTextBesideIcon);
+    toggle->setArrowType(Qt::RightArrow);
+    toggle->setText(QStringLiteral("工作进度"));
+    auto *details = new QLabel(card);
+    details->setObjectName(QStringLiteral("activityDetails"));
+    details->setWordWrap(true);
+    details->setVisible(false);
+    connect(toggle, &QToolButton::toggled, card, [toggle, details](bool shown) {
+        toggle->setArrowType(shown ? Qt::DownArrow : Qt::RightArrow);
+        details->setVisible(shown);
+    });
+    layout->addWidget(toggle);
+    layout->addWidget(details);
+    m_messagesLayout->insertWidget(qMax(0, m_messagesLayout->count() - 1), card, 0, Qt::AlignHCenter);
+    m_activityCards.insert(sessionId, card);
+    m_activityToggles.insert(sessionId, toggle);
+    m_activityDetails.insert(sessionId, details);
+}
+
+void ChatWidget::updateActivityCard(const QString &sessionId)
+{
+    ensureActivityCard(sessionId);
+    QToolButton *toggle = m_activityToggles.value(sessionId, nullptr);
+    QLabel *details = m_activityDetails.value(sessionId, nullptr);
+    if (!toggle || !details) return;
+    const QStringList lines = m_activityLines.value(sessionId);
+    toggle->setText(QStringLiteral("工作进度 · %1 项").arg(lines.size()));
+    QStringList visibleLines;
+    for (const QString &line : lines) {
+        const int markerEnd = line.indexOf(QStringLiteral("] "));
+        visibleLines.append(markerEnd >= 0 ? line.mid(markerEnd + 2) : line);
+    }
+    details->setText(visibleLines.join(QLatin1Char('\n')));
+    scrollToBottom();
+}
 
