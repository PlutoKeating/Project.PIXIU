+        persistCurrentStreamSegment(sessionId);
+    } else if (QLabel *waiting = m_streamBubbles.value(sessionId, nullptr)) {
+        waiting->setText(QStringLiteral("已开始执行任务"));
+        waiting->setProperty("streamState", QStringLiteral("responding"));
+    }
+    m_streamBubbles.remove(sessionId);
+    if (sessionId == m_currentSessionId) {
+        emit messageSent(sessionId);
+        scrollToBottom();
+    }
+}
