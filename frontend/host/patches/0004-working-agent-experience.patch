+class ChatInputEdit final : public QTextEdit
+{
+public:
+    explicit ChatInputEdit(QWidget *parent = nullptr) : QTextEdit(parent) {}
+
+    std::function<void()> submit;
+
+protected:
+    void keyPressEvent(QKeyEvent *event) override
+    {
+        const bool enter = event->key() == Qt::Key_Return || event->key() == Qt::Key_Enter;
+        const bool newline = event->modifiers().testFlag(Qt::ShiftModifier) ||
+                             event->modifiers().testFlag(Qt::ControlModifier);
+        if (enter && !newline && submit) {
+            submit();
+            event->accept();
+            return;
+        }
+        if (enter && newline) {
+            insertPlainText(QStringLiteral("\n"));
+            event->accept();
+            return;
+        }
+        QTextEdit::keyPressEvent(event);
+    }
+};
+
+QString activityName(const QString &tool)
+{
+    if (tool == QStringLiteral("terminal")) return QStringLiteral("运行命令");
+    if (tool == QStringLiteral("web_search")) return QStringLiteral("联网检索");
+    if (tool.startsWith(QStringLiteral("pixiu_memory_")) || tool == QStringLiteral("memory"))
+        return QStringLiteral("访问长期记忆");
+    if (tool == QStringLiteral("todo")) return QStringLiteral("更新任务计划");
+    if (tool == QStringLiteral("skill_view")) return QStringLiteral("加载专业能力");
+    return tool.isEmpty() ? QStringLiteral("处理任务") : tool;
+}
