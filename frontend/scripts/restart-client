#!/bin/sh
# Wait for the upgraded PIXIU client to release its single-instance socket,
# then start the newly installed client. This helper always runs unprivileged.
set -eu

case "${1:-}" in
    ''|*[!0-9]*)
        echo "usage: restart-client <old-client-pid>" >&2
        exit 2
        ;;
esac

old_pid="$1"
[ "$old_pid" -ne "$$" ] || exit 2

attempt=0
while kill -0 "$old_pid" 2>/dev/null; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 300 ]; then
        echo "pixiu-restart: old client did not exit" >&2
        exit 1
    fi
    sleep 0.1
done

exec "${PIXIU_RESTART_EXECUTABLE:-/usr/bin/pixiu}"
