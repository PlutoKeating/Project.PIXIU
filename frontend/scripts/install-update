#!/bin/sh
# Privileged upgrade boundary: copy the unprivileged download into a root-only
# file, verify that immutable copy, and only then pass it to dpkg.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

if [ "$#" -ne 3 ]; then
    echo "usage: install-update <package.deb> <sha256> <signature-base64>" >&2
    exit 2
fi

SOURCE=$1
EXPECTED=$2
SIGNATURE_BASE64=$3
case "${EXPECTED}" in
    *[!0-9A-Fa-f]*|"")
        echo "pixiu: invalid expected SHA-256" >&2
        exit 2
        ;;
esac
if [ "${#EXPECTED}" -ne 64 ]; then
    echo "pixiu: invalid expected SHA-256 length" >&2
    exit 2
fi
case "${SIGNATURE_BASE64}" in
    *[!0-9A-Za-z+/=]*|"")
        echo "pixiu: invalid release signature encoding" >&2
        exit 2
        ;;
esac
if [ "${#SIGNATURE_BASE64}" -gt 256 ]; then
    echo "pixiu: release signature exceeds size limit" >&2
    exit 2
fi
if [ ! -f "${SOURCE}" ] || [ -L "${SOURCE}" ]; then
    echo "pixiu: update package must be a regular non-symlink file" >&2
    exit 2
fi
SOURCE_SIZE=$(/usr/bin/stat --format='%s' "${SOURCE}")
if [ "${SOURCE_SIZE}" -gt 536870912 ]; then
    echo "pixiu: update package exceeds the 512 MiB limit" >&2
    exit 2
fi
# Limit files created by this process and its children to 512 MiB.  This also
# protects the root-owned copy if SOURCE is raced after the stat above.
ulimit -f 1048576

ROOT_PACKAGE=$(/usr/bin/mktemp /var/tmp/pixiu-update-root.XXXXXX.deb)
ROOT_SIGNATURE=
ROOT_DIGEST=
ROLLBACK_DIR=
SERVICE_STOPPED=0
cleanup() {
    if [ "${SERVICE_STOPPED}" -eq 1 ] && command -v systemctl >/dev/null 2>&1; then
        /usr/bin/systemctl start pixiu-backend.service >/dev/null 2>&1 || true
    fi
    /usr/bin/rm -f -- "${ROOT_PACKAGE}"
    [ -z "${ROOT_SIGNATURE}" ] || /usr/bin/rm -f -- "${ROOT_SIGNATURE}"
    [ -z "${ROOT_DIGEST}" ] || /usr/bin/rm -f -- "${ROOT_DIGEST}"
    [ -z "${ROLLBACK_DIR}" ] || /usr/bin/rm -rf -- "${ROLLBACK_DIR}"
}
trap cleanup EXIT HUP INT TERM
ROOT_SIGNATURE=$(/usr/bin/mktemp /var/tmp/pixiu-update-root.XXXXXX.sig)
ROOT_DIGEST=$(/usr/bin/mktemp /var/tmp/pixiu-update-root.XXXXXX.digest)

/usr/bin/cp -- "${SOURCE}" "${ROOT_PACKAGE}"
/usr/bin/chown root:root "${ROOT_PACKAGE}"
/usr/bin/chmod 0600 "${ROOT_PACKAGE}"

ACTUAL=$(/usr/bin/sha256sum "${ROOT_PACKAGE}")
ACTUAL=${ACTUAL%% *}
EXPECTED=$(printf '%s' "${EXPECTED}" | /usr/bin/tr 'A-F' 'a-f')
if [ "${ACTUAL}" != "${EXPECTED}" ]; then
    echo "pixiu: privileged SHA-256 verification failed" >&2
    exit 3
fi

if ! printf '%s' "${SIGNATURE_BASE64}" \
        | /usr/bin/base64 --decode >"${ROOT_SIGNATURE}" 2>/dev/null; then
    echo "pixiu: invalid release signature" >&2
    exit 3
fi
/usr/bin/chown root:root "${ROOT_SIGNATURE}" "${ROOT_DIGEST}"
/usr/bin/chmod 0600 "${ROOT_SIGNATURE}" "${ROOT_DIGEST}"
printf '%s\n' "${EXPECTED}" >"${ROOT_DIGEST}"
if ! /usr/bin/openssl pkeyutl -verify -pubin -rawin \
        -inkey /usr/share/pixiu/keys/pixiu-release-ed25519.pub \
        -in "${ROOT_DIGEST}" -sigfile "${ROOT_SIGNATURE}" >/dev/null 2>&1; then
    echo "pixiu: release signature verification failed" >&2
    exit 3
fi

PACKAGE_NAME=$(/usr/bin/dpkg-deb --field "${ROOT_PACKAGE}" Package)
PACKAGE_VERSION=$(/usr/bin/dpkg-deb --field "${ROOT_PACKAGE}" Version)
PACKAGE_ARCH=$(/usr/bin/dpkg-deb --field "${ROOT_PACKAGE}" Architecture)
SYSTEM_ARCH=$(/usr/bin/dpkg --print-architecture)
if [ "${PACKAGE_NAME}" != "pixiu" ]; then
    echo "pixiu: update package identity mismatch" >&2
    exit 3
fi
if [ "${PACKAGE_ARCH}" != "${SYSTEM_ARCH}" ] && [ "${PACKAGE_ARCH}" != "all" ]; then
    echo "pixiu: update package architecture mismatch" >&2
    exit 3
fi
# Debian's final hyphen separates the package revision.  Preserve a SemVer
# prerelease suffix such as 1.2.3-rc.1 while removing only "-1".
PRODUCT_VERSION=${PACKAGE_VERSION%-*}

HEALTH_PY=/usr/lib/pixiu/venv/bin/python
if [ ! -x "${HEALTH_PY}" ]; then
    HEALTH_PY=/usr/bin/python3
fi
command -v dpkg-repack >/dev/null 2>&1 || {
    echo "pixiu: rollback preparation requires dpkg-repack" >&2
    exit 2
}
CURRENT_VERSION=$(/usr/bin/dpkg-query -W -f='${Version}' pixiu 2>/dev/null) || {
    echo "pixiu: no installed PIXIU package to back up" >&2
    exit 2
}
ROLLBACK_DIR=$(/usr/bin/mktemp -d /var/tmp/pixiu-rollback.XXXXXX)
/usr/bin/chmod 0700 "${ROLLBACK_DIR}"
if ! (cd "${ROLLBACK_DIR}" && /usr/bin/dpkg-repack pixiu >/dev/null); then
    echo "pixiu: failed to reconstruct installed rollback package" >&2
    exit 2
fi
ROLLBACK_PACKAGE=$(find "${ROLLBACK_DIR}" -maxdepth 1 -type f \
    -name 'pixiu_*.deb' -print -quit)
if [ -z "${ROLLBACK_PACKAGE}" ]; then
    echo "pixiu: rollback package was not created" >&2
    exit 2
fi

DATABASE=/var/lib/pixiu/pixiu.db
CONFIG=/etc/pixiu/pixiu.env
DATABASE_BACKUP=${ROLLBACK_DIR}/pixiu.db
CONFIG_BACKUP=${ROLLBACK_DIR}/pixiu.env
if command -v systemctl >/dev/null 2>&1; then
    /usr/bin/systemctl stop pixiu-backend.service
    SERVICE_STOPPED=1
fi
if [ ! -f "${DATABASE}" ] || [ ! -f "${CONFIG}" ]; then
    echo "pixiu: database or configuration missing; refusing unsafe upgrade" >&2
    exit 2
fi
if ! "${HEALTH_PY}" - "${DATABASE}" "${DATABASE_BACKUP}" <<'PY'
import sqlite3
import sys

source = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
target = sqlite3.connect(sys.argv[2])
try:
    source.backup(target)
    result = target.execute("PRAGMA integrity_check").fetchone()
    if result != ("ok",):
        raise RuntimeError("backup integrity check failed")
finally:
    target.close()
    source.close()
PY
then
    echo "pixiu: database backup failed; upgrade not started" >&2
    exit 2
fi
/usr/bin/cp --preserve=mode,ownership,timestamps -- "${CONFIG}" "${CONFIG_BACKUP}"

rollback() {
    reason=$1
    echo "pixiu: ${reason}; restoring previous version ${CURRENT_VERSION}" >&2
    command -v systemctl >/dev/null 2>&1 \
        && /usr/bin/systemctl stop pixiu-backend.service >/dev/null 2>&1 || true
    SERVICE_STOPPED=1
    /usr/bin/rm -f -- "${DATABASE}-wal" "${DATABASE}-shm"
    /usr/bin/install -m 0640 -o pixiu -g pixiu \
        "${DATABASE_BACKUP}" "${DATABASE}" || exit 6
    /usr/bin/cp --preserve=mode,ownership,timestamps -- \
        "${CONFIG_BACKUP}" "${CONFIG}" || exit 6
    if ! /usr/bin/dpkg --force-confdef --force-confold -i \
            "${ROLLBACK_PACKAGE}" >/dev/null; then
        echo "pixiu: automatic rollback package installation failed" >&2
        exit 6
    fi
    SERVICE_STOPPED=0
    if command -v systemctl >/dev/null 2>&1 \
        && ! /usr/bin/systemctl is-active --quiet pixiu-backend.service; then
        echo "pixiu: automatic rollback service verification failed" >&2
        exit 6
    fi
    RESTORED_VERSION=$(/usr/bin/dpkg-query -W -f='${Version}' pixiu 2>/dev/null || true)
    if [ "${RESTORED_VERSION}" != "${CURRENT_VERSION}" ]; then
        echo "pixiu: automatic rollback version verification failed" >&2
        exit 6
    fi
    echo "pixiu: previous version restored successfully" >&2
    exit 5
}

ulimit -f unlimited
DEBIAN_FRONTEND=noninteractive
export DEBIAN_FRONTEND
# Current packages keep runtime configuration outside dpkg conffiles.  Retain
# these flags so upgrades from legacy packages also preserve their old config.
if ! /usr/bin/dpkg --force-confdef --force-confold -i "${ROOT_PACKAGE}"; then
    rollback "package installation failed"
fi
SERVICE_STOPPED=0

INSTALLED_VERSION=$(/usr/bin/dpkg-query -W -f='${Version}' pixiu)
if [ "${INSTALLED_VERSION}" != "${PACKAGE_VERSION}" ]; then
    echo "pixiu: installed package version mismatch" >&2
    rollback "installed package version mismatch"
fi
# Re-resolve after dpkg because the new package may replace the venv/runtime.
HEALTH_PY=/usr/lib/pixiu/venv/bin/python
[ -x "${HEALTH_PY}" ] || HEALTH_PY=/usr/bin/python3
if [ "${PIXIU_UPGRADE_TEST_FAIL_HEALTH:-0}" = "1" ]; then
    rollback "injected post-upgrade health failure"
elif ! PYTHONPATH=/usr/lib/pixiu "${HEALTH_PY}" \
        -m backend.foundation.api.install_health \
        --expected-version "${PRODUCT_VERSION}" \
        --provider-manifest \
        /usr/lib/pixiu/integrations/kylin_agent/pixiu/plugin.yaml; then
    rollback "post-upgrade health verification failed"
fi
