# PIXIU Foundation — 环境变量配置模板
# 复制为 backend/.env 后按需修改，切勿提交真实 .env 文件
#
# 变量名与 core/config.py 中 os.getenv 读取的名称完全一致，
# 本文件是配置变量名的唯一真相源。

# SQLite 数据库路径
PIXIU_DB_PATH=./pixiu.db

# API 网关监听地址与端口
PIXIU_API_HOST=127.0.0.1
PIXIU_API_PORT=8765

# Embedding 后端：auto（麒麟 SDK 优先，缺失时软件降级）/ kylin（严格）/ portable
PIXIU_EMBEDDING=auto

# OCR：auto 优先麒麟 kysdk-ocr、缺失时降级为结构化文本透传
PIXIU_OCR=auto

# 日志级别：DEBUG / INFO / WARNING / ERROR
PIXIU_LOG_LEVEL=INFO

# 数据目录（证据文件、缓存等）
PIXIU_DATA_DIR=./data

# ── P2P 同步（默认开启；缺证书/缺 advertise 时 runtime 降级不阻塞 API）────
# 口令：后端强制要求 ≥16 字符（加密 Ed25519 私钥），未设置或过短会启动报错。
# 运行时开关（enabled/paused）经 PUT /sync/settings 持久化并覆盖本默认值。
PIXIU_SYNC_NETWORK_ENABLED=true
PIXIU_SYNC_DEVICE_NAME=pixiu-host
PIXIU_SYNC_DOMAIN=shared:home
PIXIU_SYNC_BIND_HOST=127.0.0.1
PIXIU_SYNC_PORT=8766
PIXIU_SYNC_SERVER_NAME=
PIXIU_SYNC_ADVERTISE_ADDRESSES=
# 正式同步（多设备）前请修改此值，勿用示例占位符；systemctl restart pixiu-backend 生效。
PIXIU_SYNC_KEY_PASSPHRASE=change-me-before-production
PIXIU_SYNC_CERTFILE=
PIXIU_SYNC_KEYFILE=
PIXIU_SYNC_CAFILE=
PIXIU_SYNC_TLS_KEY_PASSWORD=
