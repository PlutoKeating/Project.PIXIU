# PIXIU Foundation — 环境变量配置模板
# 复制为 backend/.env 后按需修改，切勿提交真实 .env 文件
#
# 变量名与 core/config.py 中 os.getenv 读取的名称完全一致，
# 本文件是配置变量名的唯一真相源。

# SQLite 数据库路径
PIXIU_DB_PATH=./pixiu.db

# API 网关监听地址与端口
PIXIU_API_HOST=127.0.0.1
PIXIU_API_PORT=8765

# Embedding 后端：真实麒麟 coreai/embedding 调用（无 mock 降级，仅支持 kylin）
PIXIU_EMBEDDING=kylin

# 日志级别：DEBUG / INFO / WARNING / ERROR
PIXIU_LOG_LEVEL=INFO

# 数据目录（证据文件、缓存等）
PIXIU_DATA_DIR=./data
