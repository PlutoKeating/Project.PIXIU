# ==========================================
# Backend .dockerignore
# ==========================================

# Python dependencies & artifacts
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
*.egg-info/
.pytest_cache/

# Node.js dependencies & artifacts
node_modules/
dist/
out/

# Go artifacts
bin/
pkg/

# Java / Maven / Gradle artifacts
target/
.gradle/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Git metadata
.git/
.gitignore

# Docker config
Dockerfile
docker-compose.yml
docker-compose.*.yml
.dockerignore

# Environment variables
.env
.env.*
!.env.example

# IDE / Editor configuration
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
