#!/bin/sh
# PIXIU 一键启动器：在当前桌面用户会话准备并启动后端，再打开控制台。
set -eu

/usr/bin/pixiu-user-setup --start

# Both platform profiles use the same package-owned host and Runtime.
# Missing integration is an error, never a reason to open a second frontend.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
KYLIN_AGENT_FORCE_RUNTIME_RESTART=1
export KYLIN_AGENT_FORCE_RUNTIME_RESTART
/usr/bin/pixiu-agent-integrate --quiet
exec /usr/lib/pixiu/venv/bin/python /usr/lib/pixiu/launch-agent.py "$@"
