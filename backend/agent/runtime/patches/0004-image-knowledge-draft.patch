+    async def _handle_pixiu_dreaming(self, request: "web.Request") -> "web.Response":
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+        from backend.agent.runtime.document_tasks import dream_documents
+        try:
+            body = await request.json()
+            references = body.get("document_ids")
+            if not isinstance(references, list) or not references or len(references) > 20 or not all(isinstance(ref, str) and re.fullmatch(r"[a-f0-9]{64}", ref) for ref in references):
+                raise ValueError("Invalid document references")
+            models = self._combined_model_entries()
+            result = await dream_documents(models[0] if models else None, references)
+            return web.json_response(result)
+        except Exception:
+            return web.json_response({"error": {"message": "资料整理未完成。"}}, status=422)
+
+    async def _handle_pixiu_input_capabilities(self, request: "web.Request") -> "web.Response":
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+        from gateway.pixiu_image_draft import input_capabilities
+        models = self._combined_model_entries()
+        return web.json_response(await asyncio.to_thread(input_capabilities, models[0] if models else None))
+
+    async def _handle_pixiu_active_model(self, request: "web.Request") -> "web.Response":
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+        body = await request.json()
+        models = self._combined_model_entries()
+        selected = next((row for row in models if row.get("id") == body.get("id")), None)
+        if selected is None:
+            return web.json_response({"error": {"message": "Model unavailable"}}, status=404)
+        self._sync_models_to_config([selected] + [row for row in models if row is not selected])
+        return web.json_response({"status": "active"})
+
+    async def _handle_pixiu_attachment(self, request: "web.Request") -> "web.Response":
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+        from gateway.pixiu_image_draft import prepare_attachment, DraftError
+        try:
+            payload = await request.json()
+            models = self._combined_model_entries()
+            result = await asyncio.to_thread(prepare_attachment, models[0] if models else None, payload)
+            return web.json_response(result)
+        except (DraftError, ValueError, TypeError) as exc:
+            return web.json_response({"error": {"message": str(exc)}}, status=422)
+
+    async def _handle_pixiu_image_draft(self, request: "web.Request") -> "web.Response":
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+        from gateway.pixiu_image_draft import image_draft, DraftError
+        try:
+            payload = await request.json()
+            if not isinstance(payload, dict):
+                raise DraftError("Invalid image request")
+            return web.json_response(await image_draft(self._combined_model_entries(), payload))
+        except (DraftError, ValueError, TypeError) as exc:
+            return web.json_response({"error": {"message": str(exc)}}, status=422)
 
