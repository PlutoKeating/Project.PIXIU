# Contest delivery binaries are versioned through Git LFS so the complete
# submission workspace remains cloneable while files above GitHub's regular
# 100 MiB limit can still be pushed.
submission/**/*.avi filter=lfs diff=lfs merge=lfs -text
submission/**/*.deb filter=lfs diff=lfs merge=lfs -text
submission/**/*.docx filter=lfs diff=lfs merge=lfs -text
submission/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
submission/**/*.pdf filter=lfs diff=lfs merge=lfs -text
submission/**/*.png filter=lfs diff=lfs merge=lfs -text
submission/**/*.pptx filter=lfs diff=lfs merge=lfs -text
submission/**/*.tar.gz filter=lfs diff=lfs merge=lfs -text
submission/**/*.wmv filter=lfs diff=lfs merge=lfs -text
submission/**/*.zip filter=lfs diff=lfs merge=lfs -text

# Unified diffs require a single context marker on otherwise blank lines.
*.patch whitespace=-blank-at-eol
integrations/kylin_agent/message_renderer/*.js whitespace=-trailing-space,-blank-at-eof,-space-before-tab
integrations/kylin_agent/message_renderer/licenses/* whitespace=-blank-at-eof
