+namespace {
+QString defaultBaseUrl(const QString &provider)
+{
+    if (provider == QStringLiteral("kylin-genai")) return QStringLiteral("http://127.0.0.1:8767/v1");
+    if (provider == QStringLiteral("deepseek")) return QStringLiteral("https://api.deepseek.com/v1");
+    if (provider == QStringLiteral("anthropic")) return QStringLiteral("https://api.anthropic.com");
+    if (provider == QStringLiteral("openai")) return QStringLiteral("https://api.openai.com/v1");
+    return QString();
+}
+
+QJsonArray runtimeModels(const QVector<SavedModel> &models, const QString &editedId,
+                         const QString &apiKey)
+{
+    QJsonArray array;
+    for (const SavedModel &model : models) {
+        QJsonObject row{{QStringLiteral("id"), model.id()},
+                        {QStringLiteral("name"), model.name()},
+                        {QStringLiteral("provider"), model.provider()},
+                        {QStringLiteral("model"), model.model()},
+                        {QStringLiteral("baseUrl"), model.baseUrl()}};
+        if (model.id() == editedId && !apiKey.isEmpty()) row.insert(QStringLiteral("apiKey"), apiKey);
+        array.append(row);
+    }
+    return array;
+}
+} // namespace
