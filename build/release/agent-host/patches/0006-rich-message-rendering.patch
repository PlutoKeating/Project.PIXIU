+class MessagePage final : public QWebEnginePage
+{
+public:
+    explicit MessagePage(QObject *parent = nullptr) : QWebEnginePage(parent) {}
+
+protected:
+    bool acceptNavigationRequest(const QUrl &url, NavigationType type, bool isMainFrame) override
+    {
+        if (type == QWebEnginePage::NavigationTypeLinkClicked && isMainFrame) {
+            if (url.scheme() == QStringLiteral("https") || url.scheme() == QStringLiteral("http"))
+                QDesktopServices::openUrl(url);
+            return false;
+        }
+        return url.scheme() == QStringLiteral("qrc") || url.scheme() == QStringLiteral("about");
+    }
+};
+
+class RichMessageView final : public QWebEngineView
+{
+public:
+    explicit RichMessageView(QWidget *parent = nullptr)
+        : QWebEngineView(parent)
+    {
+        setPage(new MessagePage(this));
+        page()->setBackgroundColor(Qt::transparent);
+        settings()->setAttribute(QWebEngineSettings::LocalContentCanAccessRemoteUrls, false);
+        settings()->setAttribute(QWebEngineSettings::LocalStorageEnabled, false);
+        settings()->setAttribute(QWebEngineSettings::JavascriptCanOpenWindows, false);
+        setContextMenuPolicy(Qt::DefaultContextMenu);
+        setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+        setMinimumHeight(28);
+        connect(this, &QWebEngineView::loadFinished, this, [this](bool ok) {
+            m_ready = ok;
+            if (ok) {
+                applyTheme();
+                render();
+            }
+        });
+        connect(this, &QWebEngineView::titleChanged, this, [this](const QString &title) {
+            if (!title.startsWith(QStringLiteral("pixiu-height:"))) return;
+            const QStringList parts = title.split(QLatin1Char(':'));
+            if (parts.size() < 2) return;
+            bool ok = false;
+            const int height = parts.at(1).toInt(&ok);
+            if (ok) setFixedHeight(qBound(28, height + 2, 20000));
+        });
+        setUrl(QUrl(QStringLiteral("qrc:/message-renderer/index.html")));
+    }
+
+    void setMarkdown(const QString &markdown)
+    {
+        m_markdown = markdown;
+        render();
+    }
+
+    void applyTheme()
+    {
+        if (!m_ready) return;
+        const QPalette colors = palette();
+        const bool dark = colors.color(QPalette::Window).lightness() < 128;
+        QJsonObject theme{
+            {QStringLiteral("scheme"), dark ? QStringLiteral("dark") : QStringLiteral("light")},
+            {QStringLiteral("text"), colors.color(QPalette::WindowText).name()},
+            {QStringLiteral("muted"), colors.color(QPalette::PlaceholderText).name()},
+            {QStringLiteral("border"), colors.color(QPalette::Mid).name()},
+            {QStringLiteral("surface"), colors.color(QPalette::Base).name()},
+            {QStringLiteral("soft"), colors.color(QPalette::AlternateBase).name()},
+            {QStringLiteral("accent"), colors.color(QPalette::Link).name()},
+            {QStringLiteral("code"), colors.color(QPalette::AlternateBase).name()},
+        };
+        const QString payload = QString::fromUtf8(QJsonDocument(theme).toJson(QJsonDocument::Compact));
+        page()->runJavaScript(QStringLiteral("window.applyTheme(%1);").arg(payload));
+    }
+
+protected:
+    void changeEvent(QEvent *event) override
+    {
+        QWebEngineView::changeEvent(event);
+        if (event && (event->type() == QEvent::PaletteChange || event->type() == QEvent::StyleChange))
+            applyTheme();
+    }
+
+private:
+    void render()
+    {
+        if (!m_ready) return;
+        const QJsonArray argument{m_markdown};
+        const QString payload = QString::fromUtf8(QJsonDocument(argument).toJson(QJsonDocument::Compact));
+        page()->runJavaScript(QStringLiteral("window.renderMarkdown(%1[0]);").arg(payload));
+    }
+
+    QString m_markdown;
+    bool m_ready = false;
+};
+
+class RichMessageBubble final : public QWidget
+{
+public:
+    RichMessageBubble(const QString &content, QWidget *parent)
+        : QWidget(parent), m_view(new RichMessageView(this))
+    {
+        auto *layout = new QVBoxLayout(this);
+        layout->setContentsMargins(16, 10, 16, 10);
+        layout->setSpacing(0);
+        layout->addWidget(m_view);
+        setContent(content);
+    }
+
+    void setContent(const QString &content)
+    {
+        m_content = content;
+        m_view->setMarkdown(content);
+    }
+
+    QString content() const { return m_content; }
+
+private:
+    RichMessageView *m_view;
+    QString m_content;
+};
