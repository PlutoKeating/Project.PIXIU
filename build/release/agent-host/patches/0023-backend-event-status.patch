+            for (auto *devices : central->findChildren<pixiu::DevicePage *>()) devices->notifyDataChanged();
+        }
+        if (name == "reconnected" || name == "capture_event") {
+            for (auto *privacy : central->findChildren<pixiu::PrivacyPage *>()) privacy->notifyDataChanged();
+        }
+        if (name == "reconnected" || name == "memory_ready" || name == "forget_confirmation"
+            || name == "sync_event" || name == "capture_event" || name == "conflict_detected") {
+            for (auto *delivery : central->findChildren<pixiu::DeliveryPage *>()) delivery->notifyDataChanged();
+        }
+    });
