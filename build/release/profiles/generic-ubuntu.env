# PIXIU 目标平台画像：通用 Ubuntu（CI 默认）
# 与 kylin-v11 的差异：python3-venv 可用、Qt5 包名非 t64。

PIXIU_ARCH=amd64
PIXIU_KYSDK=OFF
PIXIU_INSTALL_STRICT=0
PIXIU_PYTHON_VERSION=312
PIXIU_DEBIAN_DEPENDS="python3 (>= 3.10), curl, dbus, openssl, dpkg-repack, pkexec, libqt5widgets5t64 | libqt5widgets5, libqt5network5t64 | libqt5network5, libqt5webenginewidgets5, libqt5websockets5, libqt5svg5, libqt5multimedia5, libgsettings-qt1, libqrencode4, fonts-noto-color-emoji"
PIXIU_DEBIAN_SUGGESTS=""
APT_RUNTIME_DEPS="python3 python3-venv dbus curl openssl dpkg-repack pkexec libqt5widgets5 libqt5network5 libqt5webenginewidgets5 libqt5websockets5 libqt5svg5 libqt5multimedia5 libgsettings-qt1 libqrencode4 fonts-noto-color-emoji"
APT_BUILD_DEPS="cmake ninja-build g++ pkg-config qtbase5-dev qtwebengine5-dev qtmultimedia5-dev libqt5svg5-dev libqt5websockets5-dev libqrencode-dev libglib2.0-dev libgsettings-qt-dev"
APT_TEST_DEPS="scrot"
