# PIXIU 目标平台画像：麒麟桌面操作系统 V11（openKylin 系，x86_64）
# 来源：192.168.122.197 真机实测（2026-08-10）
# 原则：目标机的一切差异都必须沉淀在这里（或流水线脚本），禁止一次性手工补丁。

PIXIU_ARCH=amd64

# 前端：本 VM 的 apt 源无 qtbase5-dev / kysdk-*-dev 头文件 → KYSDK=OFF 构建；
# 后续拿到带 SDK 开发包的麒麟环境时改用 KYSDK=ON（无需改结构）。
PIXIU_KYSDK=OFF

# 后端 Python：VM 为 Python 3.12.3；离线 wheels 按 cp312 打包。
PIXIU_PYTHON_VERSION=312

# .deb 运行依赖（Kylin V11 用 t64 包名；竖线兼容旧命名）
PIXIU_DEBIAN_DEPENDS="python3 (>= 3.10), curl, dbus, pkexec, libqt5widgets5t64 | libqt5widgets5, libqt5network5t64 | libqt5network5, libqt5websockets5, libqt5svg5, libgsettings-qt1, libqrencode4"

# kysdk 组件在本 VM 不可用：仅建议项，不阻塞安装（KYSDK=OFF 前端自带降级路径）
PIXIU_DEBIAN_SUGGESTS="libkysdk-shortcut, libkysdk-notification, libkysdk-qtwidgets"

# 目标机预置（provision-target.sh 幂等安装）
APT_RUNTIME_DEPS="python3 python3-venv dbus pkexec libqt5widgets5t64 libqt5network5t64 libqt5websockets5 libqt5svg5 libgsettings-qt1 libqrencode4"
# 仅测试/截图用（vm-deploy-test.sh --with-test-deps）
APT_TEST_DEPS="scrot"

# 已知事实（记录，不手动处理）：
#  - apt 源可提供 python3-venv；离线 wheels + venv 确保无网络也能完成安装。
#  - qtbase5-dev / kysdk-*-dev 在构建 VM 上可能不可用，KYSDK=OFF 前端自带降级路径。
