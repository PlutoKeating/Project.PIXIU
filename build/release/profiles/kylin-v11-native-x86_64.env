# PIXIU strict native profile: Kylin OS V11 x86_64 with all SDKs required.
# Contains only public, reproducible platform inputs; no test-facility details.

PIXIU_ARCH=amd64
PIXIU_KYSDK=ON
PIXIU_INSTALL_STRICT=1
PIXIU_PYTHON_VERSION=312

PIXIU_DEBIAN_DEPENDS="python3 (>= 3.10), curl, dbus, openssl, dpkg-repack, pkexec, libqt5widgets5t64 | libqt5widgets5, libqt5network5t64 | libqt5network5, libqt5websockets5, libqt5svg5, libgsettings-qt1, libqrencode4, libkysdk-shortcut, libkysdk-notification, libkysdk-qtwidgets, libkylin-coreai-embedding, libkysdk-vector-engine-client"
PIXIU_DEBIAN_SUGGESTS=""

APT_RUNTIME_DEPS="python3 python3-venv dbus curl openssl dpkg-repack pkexec libqt5widgets5t64 libqt5network5t64 libqt5websockets5 libqt5svg5 libgsettings-qt1 libqrencode4 libkysdk-shortcut libkysdk-notification libkysdk-qtwidgets libkylin-coreai-embedding libkysdk-vector-engine-client"
APT_BUILD_DEPS="cmake ninja-build g++ pkg-config python3-dev python3-pybind11 qtbase5-dev libqt5websockets5-dev libqrencode-dev libglib2.0-dev libkylin-coreai-embedding-dev libkysdk-vector-engine-client-dev"
APT_TEST_DEPS=""
