#!/bin/sh
# PIXIU 安装后脚本：运行时用户/数据目录、Python 环境（pip/venv 自适应）与
# 依赖安装、systemd 服务注册。
#
# 兼容性设计（针对麒麟 V11/openKylin 实测）：
#  - 部分麒麟发行版不提供 python3-venv / python3-pip：本脚本先引导 get-pip，
#    再尝试 venv，失败则回退系统 Python（PEP 668 用 --break-system-packages）。
#  - 依赖优先从随包 wheels 离线安装（--no-index），无 wheels 时在线安装。
set -e

PIXIU_USER=pixiu
PIXIU_HOME=/var/lib/pixiu
PIXIU_LIB=/usr/lib/pixiu
PY=/usr/bin/python3
VENV="${PIXIU_LIB}/venv"

echo "pixiu: configuring backend runtime environment"

# 1) 运行时用户与数据目录（SQLite 记忆/同步库目录）
if ! getent passwd "${PIXIU_USER}" >/dev/null 2>&1; then
    useradd --system --home "${PIXIU_HOME}" \
            --shell /usr/sbin/nologin "${PIXIU_USER}" 2>/dev/null || true
fi
mkdir -p "${PIXIU_HOME}" "${PIXIU_HOME}/data"
chown -Rh "${PIXIU_USER}:${PIXIU_USER}" "${PIXIU_HOME}"

# 2) pip 引导（缺失时下载 get-pip.py）
if ! "${PY}" -m pip --version >/dev/null 2>&1; then
    echo "pixiu: bootstrapping pip"
    command -v curl >/dev/null 2>&1 || {
        echo "pixiu: pip missing and curl unavailable — cannot bootstrap" >&2
        exit 1
    }
    curl -fsSL https://bootstrap.pypa.io/get-pip.py -o /tmp/pixiu-get-pip.py
    if ! PIP_BREAK_SYSTEM_PACKAGES=1 "${PY}" /tmp/pixiu-get-pip.py >/dev/null 2>&1; then
        "${PY}" /tmp/pixiu-get-pip.py --break-system-packages >/dev/null 2>&1 || {
            echo "pixiu: failed to bootstrap pip" >&2
            exit 1
        }
    fi
    rm -f /tmp/pixiu-get-pip.py
fi

# 3) Python 解释器：venv 存在时优先复用（升级/重装路径——启动器固定跑 venv，
#    依赖必须装进 venv，否则升级后服务 ModuleNotFoundError 崩溃循环）；
#    不存在才尝试创建（无 python3-venv 的发行版回退系统 Python）。
VPY="${PY}"
if [ -x "${VENV}/bin/python" ]; then
    echo "pixiu: using existing venv at ${VENV}"
    VPY="${VENV}/bin/python"
    "${VPY}" -m pip install --upgrade pip >/dev/null 2>&1 || true
elif "${PY}" -m venv "${VENV}" >/dev/null 2>&1 \
        && [ -x "${VENV}/bin/python" ]; then
    echo "pixiu: using venv at ${VENV}"
    VPY="${VENV}/bin/python"
    "${VPY}" -m pip install --upgrade pip >/dev/null 2>&1 || true
else
    echo "pixiu: python3-venv unavailable — using system Python ${PY}"
fi

# 3.5) conffile 迁移（幂等追加）：升级时 dpkg 保留用户改过的旧 /etc/pixiu/pixiu.env，
#      新模板变量不落地 → 这里补入缺失的默认变量；全新安装由 dpkg 落包内模板，跳过。
CONF="/etc/pixiu/pixiu.env"
if [ -f "${CONF}" ]; then
    grep -q '^PIXIU_MONITOR_ENABLED=' "${CONF}" \
        || echo 'PIXIU_MONITOR_ENABLED=1' >> "${CONF}"
    grep -q '^PIXIU_SYNC_NETWORK_ENABLED=' "${CONF}" \
        || echo 'PIXIU_SYNC_NETWORK_ENABLED=true' >> "${CONF}"
fi

REQ="${PIXIU_LIB}/backend/requirements.txt"
SYNC_REQ="${PIXIU_LIB}/backend/foundation/requirements-sync.txt"

install_reqs() {
    if [ "${VPY}" = "${PY}" ]; then
        # --ignore-installed：避免发行版自带包（如 typing_extensions）无 RECORD
        # 导致 pip 升级失败（麒麟 V11 实测）。
        PIP_BREAK_SYSTEM_PACKAGES=1 \
            "${VPY}" -m pip install --ignore-installed "$@" >/dev/null
    else
        "${VPY}" -m pip install "$@" >/dev/null
    fi
}

if [ -d "${PIXIU_LIB}/wheels" ] && [ -n "$(ls -A "${PIXIU_LIB}/wheels" 2>/dev/null)" ]; then
    echo "pixiu: installing backend dependencies from bundled wheels (offline)"
    if ! install_reqs --no-index --find-links="${PIXIU_LIB}/wheels" -r "${REQ}"; then
        echo "pixiu: offline wheels 不完整（目标 Python 版本不匹配等），回退在线安装"
        install_reqs -r "${REQ}"
    fi
    if [ -f "${SYNC_REQ}" ] && [ -s "${SYNC_REQ}" ]; then
        if ! install_reqs --no-index --find-links="${PIXIU_LIB}/wheels" -r "${SYNC_REQ}"; then
            install_reqs -r "${SYNC_REQ}"
        fi
    fi
else
    echo "pixiu: installing backend dependencies from PyPI (online)"
    install_reqs -r "${REQ}"
    if [ -f "${SYNC_REQ}" ] && [ -s "${SYNC_REQ}" ]; then
        install_reqs -r "${SYNC_REQ}"
    fi
fi
if [ -d "${VENV}" ]; then
    # 运行服务只需读取 venv；保持 root 所有，避免低权限后端进程改写下一次
    # 启动将执行的解释器或依赖。
    chown -Rh root:root "${VENV}"
fi

# 3.6) 同步私钥口令：包内只携带公开占位符，安装时生成每机随机值。
#      从历史公开默认值升级且已有 sync_identity 时，先原地重加密私钥；
#      device_id / public_key / peers / CRDT 状态均保持不变。迁移由 root-only
#      journal 保护，数据库提交与配置替换之间掉电也可在下次配置时恢复。
if [ -f "${CONF}" ]; then
    PYTHONPATH="${PIXIU_LIB}${PYTHONPATH:+:${PYTHONPATH}}" \
        "${VPY}" -m backend.foundation.sync.install_passphrase \
        --config "${CONF}" --default-database "${PIXIU_HOME}/pixiu.db"
    chown root:"${PIXIU_USER}" "${CONF}"
    chmod 0640 "${CONF}"
fi
# 口令迁移以 root 打开 SQLite，WAL/SHM 可能被重新创建；服务启动前恢复运行时
# 目录所有权，避免 pixiu 用户因旁车文件属主错误而无法写库。
chown -Rh "${PIXIU_USER}:${PIXIU_USER}" "${PIXIU_HOME}"

# 4) systemd 服务
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable pixiu-backend.service >/dev/null 2>&1 || true
    systemctl restart pixiu-backend.service >/dev/null 2>&1 || true
fi

echo "pixiu: install complete — backend on 127.0.0.1:8765, client via 'pixiu' or app menu."
exit 0
