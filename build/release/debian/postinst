#!/bin/sh
# PIXIU 安装后脚本：准备 root-owned Python 环境与 systemd user unit。
# 用户配置、数据和服务只能由桌面用户首次启动时创建。
#
# Python/venv 由包依赖提供；不下载引导脚本或向系统 Python 安装依赖。
# 后端依赖安装方式由包内 wheels 决定，Runtime 始终使用随包哈希锁。
set -e

PIXIU_LIB=/usr/lib/pixiu
PY=/usr/bin/python3
VENV="${PIXIU_LIB}/venv"

echo "pixiu: configuring backend runtime environment"

# 1) Validate the interpreter before creating or changing the product venv.
"${PY}" -c 'import sys; sys.exit(sys.implementation.cache_tag != "cpython-312")' || {
    echo "pixiu: packaged Runtime requires CPython 3.12" >&2
    exit 1
}

# 2) Reuse the installed venv for upgrades; never erase it or fall back to the
# system interpreter when creation, ABI validation or pip checks fail.
if [ -x "${VENV}/bin/python" ]; then
    echo "pixiu: using existing venv at ${VENV}"
elif "${PY}" -m venv "${VENV}" >/dev/null 2>&1 \
        && [ -x "${VENV}/bin/python" ]; then
    echo "pixiu: using venv at ${VENV}"
else
    echo "pixiu: cannot create the required product venv; check python3-venv" >&2
    exit 1
fi
VPY="${VENV}/bin/python"
"${VPY}" -c 'import sys; sys.exit(sys.implementation.cache_tag != "cpython-312" or sys.prefix == sys.base_prefix)' || {
    echo "pixiu: existing product venv is not an isolated CPython 3.12 environment" >&2
    exit 1
}
"${VPY}" -m pip --version >/dev/null 2>&1 || {
    echo "pixiu: product venv pip is unavailable; installation cannot continue" >&2
    exit 1
}

REQ="${PIXIU_LIB}/backend/requirements.txt"
SYNC_REQ="${PIXIU_LIB}/backend/foundation/requirements-sync.txt"

install_reqs() {
    "${VPY}" -m pip install "$@" >/dev/null
}

if [ -d "${PIXIU_LIB}/wheels" ] && [ -n "$(ls -A "${PIXIU_LIB}/wheels" 2>/dev/null)" ]; then
    echo "pixiu: installing backend dependencies from bundled wheels (offline)"
    if ! install_reqs --no-index --find-links="${PIXIU_LIB}/wheels" -r "${REQ}"; then
        echo "pixiu: offline wheels 不完整（目标 Python 版本不匹配等），回退在线安装"
        install_reqs -r "${REQ}"
    fi
    if [ -f "${SYNC_REQ}" ] && [ -s "${SYNC_REQ}" ]; then
        if ! install_reqs --no-index --find-links="${PIXIU_LIB}/wheels" -r "${SYNC_REQ}"; then
            install_reqs -r "${SYNC_REQ}"
        fi
    fi
else
    echo "pixiu: installing backend dependencies from PyPI (online)"
    install_reqs -r "${REQ}"
    if [ -f "${SYNC_REQ}" ] && [ -s "${SYNC_REQ}" ]; then
        install_reqs -r "${SYNC_REQ}"
    fi
fi
if [ -d "${VENV}" ]; then
    # 运行服务只需读取 venv；保持 root 所有，避免低权限后端进程改写下一次
    # 启动将执行的解释器或依赖。
    chown -Rh root:root "${VENV}"
fi

# 3) A complete candidate contains the Agent Runtime wheelhouse and a
# hash lock. It must install without an index into the same root-owned venv;
# falling back to network or a mutable per-user runtime is forbidden.
AGENT_ROOT="${PIXIU_LIB}/agent-runtime"
if [ -d "${AGENT_ROOT}/wheelhouse" ]; then
    [ "${VPY}" != "${PY}" ] || {
        echo "pixiu: packaged Agent Runtime requires python3-venv" >&2
        exit 1
    }
    echo "pixiu: installing hash-locked Agent Runtime from bundled wheels (offline)"
    # The upstream package version can remain unchanged while PIXIU's
    # audited distribution adapter fixes omitted non-code assets.  A normal
    # pip install would then leave the old wheel contents in place on upgrade.
    # Reinstall the entire locked closure so same-version package upgrades
    # converge to the exact Runtime artifact shipped by this .deb.
    install_reqs --no-index --find-links="${AGENT_ROOT}/wheelhouse" \
        --force-reinstall --require-hashes -r "${AGENT_ROOT}/runtime-cp312.lock"
    [ -x "${VENV}/bin/kylin-agent-runtime" ] || {
        echo "pixiu: packaged Agent Runtime entry point is missing" >&2
        exit 1
    }
fi

# 4) 停用旧版系统服务，但保留 /var/lib/pixiu 与 /etc/pixiu 供显式迁移。
if command -v systemctl >/dev/null 2>&1; then
    systemctl stop pixiu-backend.service >/dev/null 2>&1 || true
    systemctl disable pixiu-backend.service >/dev/null 2>&1 || true
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

echo "pixiu: install complete — launch 'pixiu' in the desktop session to initialize the private user service."
exit 0
