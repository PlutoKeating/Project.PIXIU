[Unit]
Description=PIXIU Memory Backend (API + local SQLite sync store)
After=network.target

[Service]
Type=simple
User=pixiu
Group=pixiu
EnvironmentFile=/etc/pixiu/pixiu.env
Environment=PIXIU_PRODUCT_VERSION=@PRODUCT_VERSION@
ExecStart=/usr/bin/pixiu-backend
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
