# PIXIU 后端用户配置模板（首次启动复制到 $XDG_CONFIG_HOME/pixiu/pixiu.env）
# 变量名与 backend/foundation/core/config.py 读取名称一致。

# API 网关（HTTP + WS 共用端口 8765）
PIXIU_API_HOST=127.0.0.1
PIXIU_API_PORT=8765

# 数据库、数据与 Vector Engine 文件默认位于 $XDG_DATA_HOME/pixiu；如无明确
# 管理需求，请勿覆盖路径，以免数据跨用户或偏离备份/迁移边界。

# Embedding：auto 优先麒麟 SDK、缺失时兼容 Debian；麒麟验收改为 kylin
PIXIU_EMBEDDING=auto
# Vector Engine：auto 优先系统 SDK；最终严格验收改为 kylin
PIXIU_VECTOR_STORE=auto
# 生产路径使用官方 ConnectParam(appId) 本地传输。
PIXIU_VECTOR_APP_ID=pixiu
PIXIU_VECTOR_COLLECTION=pixiu_memory
PIXIU_LOG_LEVEL=INFO

# ── 目录监视（批次②，默认开启）──
PIXIU_MONITOR_ENABLED=1

# ── P2P 同步（默认开启；缺证书/缺 advertise 时 runtime 降级不阻塞 API）──
PIXIU_SYNC_NETWORK_ENABLED=true
PIXIU_SYNC_DEVICE_NAME=pixiu-host
PIXIU_SYNC_DOMAIN=shared:home
PIXIU_SYNC_BIND_HOST=127.0.0.1
PIXIU_SYNC_PORT=8766
# 首次用户启动会在写入同步身份前替换此公开占位符；迁移工具负责从旧系统
# 数据安全保留既有设备身份。发布候选不得保留此值。
PIXIU_SYNC_KEY_PASSPHRASE=change-me-before-production
# PIXIU_SYNC_SERVER_NAME=
# PIXIU_SYNC_ADVERTISE_ADDRESSES=
# PIXIU_SYNC_CERTFILE=
# PIXIU_SYNC_KEYFILE=
# PIXIU_SYNC_CAFILE=
# PIXIU_SYNC_TLS_KEY_PASSWORD=

# 注意：PIXIU_SYNC_KEY_PASSPHRASE 用于加密 Ed25519 私钥。安装后的配置文件权限
# 为当前用户 0600；如需人工轮换，应同时重加密已有同步身份。
