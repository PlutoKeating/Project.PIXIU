# PIXIU 后端环境变量模板（安装到 /etc/pixiu/pixiu.env，随包为 conffile）
# 变量名与 backend/foundation/core/config.py 读取名称一致。

# API 网关（HTTP + WS 共用端口 8765）
PIXIU_API_HOST=127.0.0.1
PIXIU_API_PORT=8765

# 本地 SQLite 记忆/同步数据库（首次启动自动迁移建表）
PIXIU_DB_PATH=/var/lib/pixiu/pixiu.db
PIXIU_DATA_DIR=/var/lib/pixiu/data

# Embedding：auto 优先麒麟 SDK、缺失时兼容 Debian；麒麟验收改为 kylin
PIXIU_EMBEDDING=auto
PIXIU_LOG_LEVEL=INFO

# ── 目录监视（批次②，默认开启）──
PIXIU_MONITOR_ENABLED=1

# ── P2P 同步（默认关闭；开启前请配置 TLS 证书与口令）──
PIXIU_SYNC_NETWORK_ENABLED=false
PIXIU_SYNC_DEVICE_NAME=pixiu-host
PIXIU_SYNC_DOMAIN=shared:home
PIXIU_SYNC_BIND_HOST=127.0.0.1
PIXIU_SYNC_PORT=8766
PIXIU_SYNC_KEY_PASSPHRASE=pixiu-local-sync-change-me-2026
# PIXIU_SYNC_SERVER_NAME=
# PIXIU_SYNC_ADVERTISE_ADDRESSES=
# PIXIU_SYNC_CERTFILE=
# PIXIU_SYNC_KEYFILE=
# PIXIU_SYNC_CAFILE=
# PIXIU_SYNC_TLS_KEY_PASSWORD=

# 注意：PIXIU_SYNC_KEY_PASSPHRASE 是后端强制要求（≥16 字符，用于加密 Ed25519
# 私钥）。上方为安装默认值，仅用于本地单机；正式多设备同步前请在目标机修改为
# 独立强口令（修改后 systemctl restart pixiu-backend 生效）。
