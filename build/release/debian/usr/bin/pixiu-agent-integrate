#!/bin/sh
# Install/upgrade the packaged PIXIU MemoryProvider in the current user's
# openKylin Agent profile. Never overwrites an unmanaged same-name plugin.
set -eu

SOURCE="${PIXIU_AGENT_PLUGIN_SOURCE:-/usr/lib/pixiu/integrations/kylin_agent/pixiu}"
AGENT_HOME="${HERMES_HOME:-${HOME:-}/.kylin-agent-runtime}"
PLUGIN_ROOT="${AGENT_HOME}/plugins"
DEST="${PLUGIN_ROOT}/pixiu"
MARKER="${DEST}/.pixiu-managed"
QUIET=0
STRICT_FILE="${PIXIU_AGENT_DEFAULT_STRICT_FILE:-/usr/share/pixiu/install-strict}"
USER_SETUP="${PIXIU_USER_SETUP_BIN:-/usr/bin/pixiu-user-setup}"
SYSTEMCTL="${PIXIU_SYSTEMCTL_BIN:-systemctl}"
GATEWAY_UNIT="kylin-agent-runtime-gateway.service"
PACKAGED_UNIT="${PIXIU_AGENT_GATEWAY_UNIT:-/usr/lib/systemd/user/${GATEWAY_UNIT}}"

if [ "${1:-}" = "--quiet" ]; then
    QUIET=1
elif [ -n "${1:-}" ]; then
    echo "usage: pixiu-agent-integrate [--quiet]" >&2
    exit 2
fi

say() {
    [ "${QUIET}" = "1" ] || printf '%s\n' "$1"
}

fail() {
    printf 'pixiu-agent-integrate: %s\n' "$1" >&2
    exit "${2:-1}"
}

[ -n "${HOME:-}" ] || fail "HOME is not set" 2
case "${AGENT_HOME}" in
    /*) ;;
    *) fail "Agent profile path must be absolute" 2 ;;
esac
[ "${AGENT_HOME}" != "/" ] || fail "refusing root as Agent profile" 2
[ -f "${SOURCE}/__init__.py" ] || fail "packaged provider is missing" 2
[ -f "${SOURCE}/plugin.yaml" ] || [ -f "${SOURCE}/plugin.yaml.in" ] \
    || fail "provider manifest is missing" 2

DEFAULT_STRICT=0
if [ -f "${STRICT_FILE}" ]; then
    DEFAULT_STRICT="$(tr -d '\r\n' < "${STRICT_FILE}")"
fi
case "${DEFAULT_STRICT}" in
    0|1) ;;
    *) fail "packaged strict-mode marker is invalid" 2 ;;
esac

# The Agent runtime is owned by the desktop user and may legitimately live in
# ~/.local/bin. Validate it in this user-context activation step, before any
# profile mutation, rather than in root's Debian preinst environment.
HOST="${PIXIU_AGENT_HOST_BIN:-}"
if [ -z "${HOST}" ]; then
    if [ "${DEFAULT_STRICT}" = "1" ] && [ -x /usr/bin/kylin-agent ]; then
        HOST=/usr/bin/kylin-agent
    else
        HOST="$(command -v kylin-agent 2>/dev/null || true)"
    fi
fi
[ -n "${HOST}" ] && [ -x "${HOST}" ] \
    || fail "openKylin Agent desktop host is not available" 4

RUNTIME="${PIXIU_AGENT_RUNTIME_BIN:-}"
if [ -z "${RUNTIME}" ]; then
    if [ "${DEFAULT_STRICT}" = "1" ] \
       && [ -x /usr/bin/kylin-agent-runtime ]; then
        RUNTIME=/usr/bin/kylin-agent-runtime
    elif command -v kylin-agent-runtime >/dev/null 2>&1; then
        RUNTIME="$(command -v kylin-agent-runtime)"
    elif command -v hermes >/dev/null 2>&1; then
        RUNTIME="$(command -v hermes)"
    else
        fail "openKylin Agent runtime not found" 4
    fi
fi
[ -x "${RUNTIME}" ] || fail "openKylin Agent runtime is not executable" 4
if ! RUNTIME_VERSION_OUTPUT="$("${RUNTIME}" --version 2>&1)"; then
    fail "openKylin Agent runtime version command failed" 4
fi
RUNTIME_VERSION="$(printf '%s\n' "${RUNTIME_VERSION_OUTPUT}" \
    | grep -Eo '0\.9\.[0-9]+' || true)"
VERSION_COUNT="$(printf '%s\n' "${RUNTIME_VERSION}" | grep -c . || true)"
[ "${VERSION_COUNT}" = "1" ] \
    && printf '%s\n' "${RUNTIME_VERSION}" | grep -Eq '^0\.9\.[0-9]+$' \
    || fail "openKylin Agent runtime must report exactly one verified 0.9.x version" 4

mkdir -p "${PLUGIN_ROOT}"
if [ -L "${DEST}" ]; then
    fail "refusing symlinked plugin destination: ${DEST}" 3
fi
if [ -e "${DEST}" ] && [ ! -f "${MARKER}" ]; then
    fail "refusing to overwrite unmanaged plugin: ${DEST}" 3
fi

USER_UNIT_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
BACKUP_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/pixiu/service-backups"
USER_UNIT="${USER_UNIT_DIR}/${GATEWAY_UNIT}"

managed_gateway_unit() {
    UNIT_PATH="$1"
    [ -f "${UNIT_PATH}" ] && [ ! -L "${UNIT_PATH}" ] || return 1
    [ "$(grep -Ec '^ExecStart=' "${UNIT_PATH}" || true)" = "1" ] || return 1
    ! grep -Eq '^Exec(StartPre|StartPost|Stop|StopPost)=' "${UNIT_PATH}" || return 1
    grep -Eq '^ExecStart="?[^[:space:]"]*(kylin-agent-runtime|hermes)"?[[:space:]]+gateway[[:space:]]+run[[:space:]]+--replace[[:space:]]*$' "${UNIT_PATH}" \
        || grep -Eq '^ExecStart="?[^[:space:]"]*python(3(\.[0-9]+)?)?"?[[:space:]]+-m[[:space:]]+kylin_agent_runtime_cli(\.main)?[[:space:]]+gateway[[:space:]]+run[[:space:]]+--replace[[:space:]]*$' "${UNIT_PATH}"
}

# Reject every unsafe collision before changing the profile or user units.
if [ "${DEFAULT_STRICT}" = "1" ]; then
    [ -f "${PACKAGED_UNIT}" ] && [ ! -L "${PACKAGED_UNIT}" ] \
        || fail "packaged Agent gateway unit is missing or unsafe" 2
    case "${SYSTEMCTL}" in
        */*) [ -x "${SYSTEMCTL}" ] || fail "systemctl helper is not executable" 2 ;;
        *) command -v "${SYSTEMCTL}" >/dev/null 2>&1 \
            || fail "systemctl is not available" 2 ;;
    esac
    for UNIT_NAME in hermes-gateway.service hermes.service "${GATEWAY_UNIT}"; do
        UNIT_PATH="${USER_UNIT_DIR}/${UNIT_NAME}"
        [ -e "${UNIT_PATH}" ] || continue
        managed_gateway_unit "${UNIT_PATH}" \
            || fail "refusing to replace unmanaged Agent gateway unit: ${UNIT_PATH}" 3
    done
fi

# Agent may activate the Provider without first opening the PIXIU console.
# Start the backend only after all profile and unit preflight checks pass.
if [ -x "${USER_SETUP}" ]; then
    "${USER_SETUP}" --start || fail "PIXIU user service failed to start" 4
fi

TMP="${PLUGIN_ROOT}/.pixiu.install.$$"
BACKUP="${PLUGIN_ROOT}/.pixiu.backup.$$"
TX_ROOT="${AGENT_HOME}/.pixiu.transaction.$$"
ENV_FILE="${AGENT_HOME}/.env"
CONFIG_FILE="${AGENT_HOME}/config.yaml"
TX_ACTIVE=0
HAD_DEST=0
HAD_ENV=0
HAD_CONFIG=0
cleanup() {
    STATUS=$?
    if [ "${TX_ACTIVE}" = "1" ] && [ "${STATUS}" -ne 0 ]; then
        rm -rf -- "${DEST}"
        if [ "${HAD_DEST}" = "1" ] && [ -d "${BACKUP}" ]; then
            mv "${BACKUP}" "${DEST}" || true
        fi
        if [ "${HAD_ENV}" = "1" ]; then
            cp "${TX_ROOT}/env" "${ENV_FILE}" || true
        else
            rm -f -- "${ENV_FILE}"
        fi
        if [ "${HAD_CONFIG}" = "1" ]; then
            cp "${TX_ROOT}/config.yaml" "${CONFIG_FILE}" || true
        else
            rm -f -- "${CONFIG_FILE}"
        fi
        if [ "${DEFAULT_STRICT}" = "1" ] && [ -d "${TX_ROOT}/units" ]; then
            mkdir -p "${USER_UNIT_DIR}"
            for UNIT_NAME in hermes-gateway.service hermes.service "${GATEWAY_UNIT}"; do
                UNIT_PATH="${USER_UNIT_DIR}/${UNIT_NAME}"
                if [ -f "${TX_ROOT}/units/${UNIT_NAME}" ]; then
                    cp "${TX_ROOT}/units/${UNIT_NAME}" "${UNIT_PATH}" || true
                else
                    rm -f -- "${UNIT_PATH}"
                fi
            done
            "${SYSTEMCTL}" --user daemon-reload >/dev/null 2>&1 || true
            for UNIT_NAME in hermes-gateway.service hermes.service "${GATEWAY_UNIT}"; do
                [ -f "${TX_ROOT}/units/${UNIT_NAME}" ] || continue
                "${SYSTEMCTL}" --user enable --now "${UNIT_NAME}" >/dev/null 2>&1 || true
            done
        fi
    fi
    if [ -d "${TMP}" ]; then
        rm -rf -- "${TMP}"
    fi
    rm -rf -- "${TX_ROOT}"
    return "${STATUS}"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir "${TMP}"
cp -R "${SOURCE}/." "${TMP}/"
if [ ! -f "${TMP}/plugin.yaml" ]; then
    VERSION_FILE="${PIXIU_PRODUCT_VERSION_FILE:-/usr/share/pixiu/VERSION}"
    if [ ! -f "${VERSION_FILE}" ]; then
        VERSION_FILE="${SOURCE}/../../../VERSION"
    fi
    [ -f "${VERSION_FILE}" ] || fail "product VERSION is missing" 2
    PRODUCT_VERSION="$(tr -d '\r\n' < "${VERSION_FILE}")"
    printf '%s\n' "${PRODUCT_VERSION}" \
        | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' \
        || fail "product VERSION is invalid" 2
    sed "s/@VERSION@/${PRODUCT_VERSION}/g" "${TMP}/plugin.yaml.in" \
        > "${TMP}/plugin.yaml"
    rm -f "${TMP}/plugin.yaml.in"
fi
find "${TMP}" -type d -exec chmod 0755 {} \;
find "${TMP}" -type f -exec chmod 0644 {} \;
VERSION="$(sed -n 's/^version:[[:space:]]*//p' "${TMP}/plugin.yaml" | head -n 1)"
printf '%s\n' "${VERSION:-unknown}" > "${TMP}/.pixiu-managed"

mkdir "${TX_ROOT}"
if [ -d "${DEST}" ]; then
    HAD_DEST=1
fi
if [ -f "${ENV_FILE}" ]; then
    HAD_ENV=1
    cp "${ENV_FILE}" "${TX_ROOT}/env"
fi
if [ -f "${CONFIG_FILE}" ]; then
    HAD_CONFIG=1
    cp "${CONFIG_FILE}" "${TX_ROOT}/config.yaml"
fi
if [ "${DEFAULT_STRICT}" = "1" ]; then
    mkdir -p "${TX_ROOT}/units" "${BACKUP_DIR}"
    for UNIT_NAME in hermes-gateway.service hermes.service "${GATEWAY_UNIT}"; do
        UNIT_PATH="${USER_UNIT_DIR}/${UNIT_NAME}"
        [ -f "${UNIT_PATH}" ] || continue
        cp "${UNIT_PATH}" "${TX_ROOT}/units/${UNIT_NAME}"
        UNIT_DIGEST="$(sha256sum "${UNIT_PATH}" | awk '{print $1}')"
        UNIT_BACKUP="${BACKUP_DIR}/${UNIT_NAME}.pre-pixiu.${UNIT_DIGEST}"
        if [ ! -f "${UNIT_BACKUP}" ]; then
            cp "${UNIT_PATH}" "${UNIT_BACKUP}"
            chmod 0600 "${UNIT_BACKUP}"
        fi
    done
fi
TX_ACTIVE=1

if [ -d "${DEST}" ]; then
    mv "${DEST}" "${BACKUP}"
fi
if ! mv "${TMP}" "${DEST}"; then
    if [ -d "${BACKUP}" ]; then
        mv "${BACKUP}" "${DEST}"
    fi
    fail "provider activation failed" 1
fi

# Provider settings belong to the desktop user's Agent process, not the
# root-owned backend service environment. Preserve any explicit user values.
touch "${ENV_FILE}"
chmod 0600 "${ENV_FILE}"
grep -q '^PIXIU_AGENT_ENDPOINT=' "${ENV_FILE}" \
    || printf '%s\n' 'PIXIU_AGENT_ENDPOINT=http://127.0.0.1:8765' >> "${ENV_FILE}"
grep -q '^PIXIU_AGENT_SCOPE=' "${ENV_FILE}" \
    || printf '%s\n' 'PIXIU_AGENT_SCOPE=user:default' >> "${ENV_FILE}"
if [ "${DEFAULT_STRICT}" = "1" ]; then
    if grep -q '^PIXIU_AGENT_STRICT=' "${ENV_FILE}"; then
        sed -i 's/^PIXIU_AGENT_STRICT=.*/PIXIU_AGENT_STRICT=1/' "${ENV_FILE}"
    else
        printf '%s\n' 'PIXIU_AGENT_STRICT=1' >> "${ENV_FILE}"
    fi
else
    grep -q '^PIXIU_AGENT_STRICT=' "${ENV_FILE}" \
        || printf '%s\n' 'PIXIU_AGENT_STRICT=0' >> "${ENV_FILE}"
fi

HERMES_HOME="${AGENT_HOME}" "${RUNTIME}" config set memory.provider pixiu >/dev/null \
    || fail "Agent runtime rejected memory.provider=pixiu" 5

# A strict release owns the complete Agent runtime. Migrate an older generated
# per-user override out of systemd's precedence path, but retain a recoverable
# copy under PIXIU state before activating the package-owned unit.
if [ "${DEFAULT_STRICT}" = "1" ]; then
    for LEGACY_UNIT in hermes-gateway.service hermes.service; do
        LEGACY_PATH="${USER_UNIT_DIR}/${LEGACY_UNIT}"
        [ -f "${LEGACY_PATH}" ] || continue
        "${SYSTEMCTL}" --user disable --now "${LEGACY_UNIT}" \
            || fail "failed to stop legacy Agent gateway ${LEGACY_UNIT}" 5
        rm -f -- "${LEGACY_PATH}"
    done
    if [ -f "${USER_UNIT}" ]; then
        rm -f -- "${USER_UNIT}"
    fi
    "${SYSTEMCTL}" --user daemon-reload \
        || fail "failed to reload the user service manager" 5
    "${SYSTEMCTL}" --user enable --now "${GATEWAY_UNIT}" \
        || fail "failed to activate the packaged Agent gateway" 5
fi
TX_ACTIVE=0
rm -rf -- "${BACKUP}" "${TX_ROOT}"
say "PIXIU Agent memory provider is installed and active."
