#!/bin/sh
# Install/upgrade the packaged PIXIU MemoryProvider in the current user's
# openKylin Agent profile. Never overwrites an unmanaged same-name plugin.
set -eu

SOURCE="${PIXIU_AGENT_PLUGIN_SOURCE:-/usr/lib/pixiu/integrations/kylin_agent/pixiu}"
AGENT_HOME="${HERMES_HOME:-${HOME:-}/.kylin-agent-runtime}"
PLUGIN_ROOT="${AGENT_HOME}/plugins"
DEST="${PLUGIN_ROOT}/pixiu"
MARKER="${DEST}/.pixiu-managed"
QUIET=0
STRICT_FILE="${PIXIU_AGENT_DEFAULT_STRICT_FILE:-/usr/share/pixiu/install-strict}"

if [ "${1:-}" = "--quiet" ]; then
    QUIET=1
elif [ -n "${1:-}" ]; then
    echo "usage: pixiu-agent-integrate [--quiet]" >&2
    exit 2
fi

say() {
    [ "${QUIET}" = "1" ] || printf '%s\n' "$1"
}

fail() {
    printf 'pixiu-agent-integrate: %s\n' "$1" >&2
    exit "${2:-1}"
}

[ -n "${HOME:-}" ] || fail "HOME is not set" 2
case "${AGENT_HOME}" in
    /*) ;;
    *) fail "Agent profile path must be absolute" 2 ;;
esac
[ "${AGENT_HOME}" != "/" ] || fail "refusing root as Agent profile" 2
[ -f "${SOURCE}/__init__.py" ] || fail "packaged provider is missing" 2
[ -f "${SOURCE}/plugin.yaml" ] || [ -f "${SOURCE}/plugin.yaml.in" ] \
    || fail "provider manifest is missing" 2

DEFAULT_STRICT=0
if [ -f "${STRICT_FILE}" ]; then
    DEFAULT_STRICT="$(tr -d '\r\n' < "${STRICT_FILE}")"
fi
case "${DEFAULT_STRICT}" in
    0|1) ;;
    *) fail "packaged strict-mode marker is invalid" 2 ;;
esac

# The Agent runtime is owned by the desktop user and may legitimately live in
# ~/.local/bin. Validate it in this user-context activation step, before any
# profile mutation, rather than in root's Debian preinst environment.
HOST="${PIXIU_AGENT_HOST_BIN:-}"
if [ -z "${HOST}" ]; then
    HOST="$(command -v kylin-agent 2>/dev/null || true)"
fi
[ -n "${HOST}" ] && [ -x "${HOST}" ] \
    || fail "openKylin Agent desktop host is not available" 4

RUNTIME="${PIXIU_AGENT_RUNTIME_BIN:-}"
if [ -z "${RUNTIME}" ]; then
    if command -v kylin-agent-runtime >/dev/null 2>&1; then
        RUNTIME="$(command -v kylin-agent-runtime)"
    elif command -v hermes >/dev/null 2>&1; then
        RUNTIME="$(command -v hermes)"
    else
        fail "openKylin Agent runtime not found" 4
    fi
fi
[ -x "${RUNTIME}" ] || fail "openKylin Agent runtime is not executable" 4
if ! RUNTIME_VERSION_OUTPUT="$("${RUNTIME}" --version 2>&1)"; then
    fail "openKylin Agent runtime version command failed" 4
fi
RUNTIME_VERSION="$(printf '%s\n' "${RUNTIME_VERSION_OUTPUT}" \
    | grep -Eo '0\.9\.[0-9]+' || true)"
VERSION_COUNT="$(printf '%s\n' "${RUNTIME_VERSION}" | grep -c . || true)"
[ "${VERSION_COUNT}" = "1" ] \
    && printf '%s\n' "${RUNTIME_VERSION}" | grep -Eq '^0\.9\.[0-9]+$' \
    || fail "openKylin Agent runtime must report exactly one verified 0.9.x version" 4

mkdir -p "${PLUGIN_ROOT}"
if [ -e "${DEST}" ] && [ ! -f "${MARKER}" ]; then
    fail "refusing to overwrite unmanaged plugin: ${DEST}" 3
fi

TMP="${PLUGIN_ROOT}/.pixiu.install.$$"
BACKUP="${PLUGIN_ROOT}/.pixiu.backup.$$"
cleanup() {
    if [ -d "${TMP}" ]; then
        rm -rf -- "${TMP}"
    fi
}
trap cleanup EXIT HUP INT TERM

mkdir "${TMP}"
cp -R "${SOURCE}/." "${TMP}/"
if [ ! -f "${TMP}/plugin.yaml" ]; then
    VERSION_FILE="${PIXIU_PRODUCT_VERSION_FILE:-/usr/share/pixiu/VERSION}"
    if [ ! -f "${VERSION_FILE}" ]; then
        VERSION_FILE="${SOURCE}/../../../VERSION"
    fi
    [ -f "${VERSION_FILE}" ] || fail "product VERSION is missing" 2
    PRODUCT_VERSION="$(tr -d '\r\n' < "${VERSION_FILE}")"
    printf '%s\n' "${PRODUCT_VERSION}" \
        | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' \
        || fail "product VERSION is invalid" 2
    sed "s/@VERSION@/${PRODUCT_VERSION}/g" "${TMP}/plugin.yaml.in" \
        > "${TMP}/plugin.yaml"
    rm -f "${TMP}/plugin.yaml.in"
fi
find "${TMP}" -type d -exec chmod 0755 {} \;
find "${TMP}" -type f -exec chmod 0644 {} \;
VERSION="$(sed -n 's/^version:[[:space:]]*//p' "${TMP}/plugin.yaml" | head -n 1)"
printf '%s\n' "${VERSION:-unknown}" > "${TMP}/.pixiu-managed"

if [ -d "${DEST}" ]; then
    mv "${DEST}" "${BACKUP}"
fi
if ! mv "${TMP}" "${DEST}"; then
    if [ -d "${BACKUP}" ]; then
        mv "${BACKUP}" "${DEST}"
    fi
    fail "provider activation failed" 1
fi
if [ -d "${BACKUP}" ]; then
    rm -rf -- "${BACKUP}"
fi

# Provider settings belong to the desktop user's Agent process, not the
# root-owned backend service environment. Preserve any explicit user values.
ENV_FILE="${AGENT_HOME}/.env"
touch "${ENV_FILE}"
chmod 0600 "${ENV_FILE}"
grep -q '^PIXIU_AGENT_ENDPOINT=' "${ENV_FILE}" \
    || printf '%s\n' 'PIXIU_AGENT_ENDPOINT=http://127.0.0.1:8765' >> "${ENV_FILE}"
grep -q '^PIXIU_AGENT_SCOPE=' "${ENV_FILE}" \
    || printf '%s\n' 'PIXIU_AGENT_SCOPE=user:default' >> "${ENV_FILE}"
if [ "${DEFAULT_STRICT}" = "1" ]; then
    if grep -q '^PIXIU_AGENT_STRICT=' "${ENV_FILE}"; then
        sed -i 's/^PIXIU_AGENT_STRICT=.*/PIXIU_AGENT_STRICT=1/' "${ENV_FILE}"
    else
        printf '%s\n' 'PIXIU_AGENT_STRICT=1' >> "${ENV_FILE}"
    fi
else
    grep -q '^PIXIU_AGENT_STRICT=' "${ENV_FILE}" \
        || printf '%s\n' 'PIXIU_AGENT_STRICT=0' >> "${ENV_FILE}"
fi

HERMES_HOME="${AGENT_HOME}" "${RUNTIME}" config set memory.provider pixiu >/dev/null \
    || fail "Agent runtime rejected memory.provider=pixiu" 5
say "PIXIU Agent memory provider is installed and active."
