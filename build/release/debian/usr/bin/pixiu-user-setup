#!/bin/sh
# Prepare the current user's private PIXIU runtime directories and optionally
# start the systemd user service. This helper never scans other users' homes.
set -eu

MODE=${1:---prepare-only}
case "${MODE}" in
    --prepare-only|--start) ;;
    *)
        echo "usage: pixiu-user-setup [--prepare-only|--start]" >&2
        exit 2
        ;;
esac

[ -n "${HOME:-}" ] || {
    echo "pixiu-user-setup: HOME is not set" >&2
    exit 2
}
[ "$(id -u)" -ne 0 ] || {
    echo "pixiu-user-setup: run this command as the desktop user, not root" >&2
    exit 2
}

XDG_DATA_HOME=${XDG_DATA_HOME:-${HOME}/.local/share}
XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-${HOME}/.config}
XDG_STATE_HOME=${XDG_STATE_HOME:-${HOME}/.local/state}
DATA_DIR="${XDG_DATA_HOME}/pixiu"
CONFIG_DIR="${XDG_CONFIG_HOME}/pixiu"
STATE_DIR="${XDG_STATE_HOME}/pixiu"
CONFIG="${CONFIG_DIR}/pixiu.env"
DEFAULT_CONFIG=${PIXIU_DEFAULT_CONFIG:-/usr/share/pixiu/pixiu.env.default}
STRICT_FILE=${PIXIU_STRICT_FILE:-/usr/share/pixiu/install-strict}

umask 077
mkdir -p "${DATA_DIR}/data" "${CONFIG_DIR}" "${STATE_DIR}"
chmod 0700 "${DATA_DIR}" "${DATA_DIR}/data" "${CONFIG_DIR}" "${STATE_DIR}"

MIGRATION_MARKER="${STATE_DIR}/migration-v1.json"
if [ -f /var/lib/pixiu/pixiu.db ] && [ ! -e "${MIGRATION_MARKER}" ]; then
    command -v pkexec >/dev/null 2>&1 || {
        echo "pixiu-user-setup: system authorization is required to migrate legacy memory" >&2
        exit 3
    }
    pkexec /usr/lib/pixiu/migrate-system-data \
        --uid "$(id -u)" --data-dir "${DATA_DIR}" \
        --config-dir "${CONFIG_DIR}" --state-dir "${STATE_DIR}"
fi
if [ ! -e "${CONFIG}" ]; then
    [ -f "${DEFAULT_CONFIG}" ] || {
        echo "pixiu-user-setup: packaged default configuration is missing" >&2
        exit 2
    }
    cp "${DEFAULT_CONFIG}" "${CONFIG}"
fi
if grep -q '^PIXIU_SYNC_KEY_PASSPHRASE=change-me-before-production$' "${CONFIG}"; then
    command -v openssl >/dev/null 2>&1 || {
        echo "pixiu-user-setup: openssl is required to initialize device identity" >&2
        exit 2
    }
    PASSPHRASE=$(openssl rand -hex 32)
    sed -i "s/^PIXIU_SYNC_KEY_PASSPHRASE=change-me-before-production$/PIXIU_SYNC_KEY_PASSPHRASE=${PASSPHRASE}/" "${CONFIG}"
fi

STRICT=0
if [ -f "${STRICT_FILE}" ]; then
    STRICT=$(tr -d '\r\n' <"${STRICT_FILE}")
fi
case "${STRICT}" in
    0) ;;
    1)
        for setting in PIXIU_EMBEDDING PIXIU_VECTOR_STORE; do
            if grep -q "^${setting}=" "${CONFIG}"; then
                sed -i "s/^${setting}=.*/${setting}=kylin/" "${CONFIG}"
            else
                printf '%s\n' "${setting}=kylin" >>"${CONFIG}"
            fi
        done
        ;;
    *)
        echo "pixiu-user-setup: packaged strict marker is invalid" >&2
        exit 2
        ;;
esac
chmod 0600 "${CONFIG}"

if [ "${MODE}" = "--start" ]; then
    command -v systemctl >/dev/null 2>&1 || {
        echo "pixiu-user-setup: systemd user manager is required" >&2
        exit 4
    }
    systemctl --user daemon-reload
    systemctl --user start pixiu-backend.service

    # A process from another UID (or an unrelated service on the same port)
    # must not satisfy startup merely by returning HTTP. Require the user
    # manager's MainPID to belong to this UID, then verify PIXIU identity and
    # package version over loopback.
    EXPECTED_VERSION=$(tr -d '\r\n' </usr/share/pixiu/VERSION)
    SERVICE_PID=$(systemctl --user show --property MainPID --value pixiu-backend.service)
    case "${SERVICE_PID}" in
        ''|0|*[!0-9]*)
            echo "pixiu-user-setup: user service has no valid main process" >&2
            exit 4
            ;;
    esac
    PROCESS_UID=$(awk '/^Uid:/{print $2; exit}' "/proc/${SERVICE_PID}/status" 2>/dev/null || true)
    [ "${PROCESS_UID}" = "$(id -u)" ] || {
        echo "pixiu-user-setup: user service process identity mismatch" >&2
        exit 4
    }

    set -a
    . "${CONFIG}"
    set +a
    [ "${PIXIU_API_HOST:-127.0.0.1}" = "127.0.0.1" ] || {
        echo "pixiu-user-setup: packaged desktop service must use loopback" >&2
        exit 4
    }
    VERSION_URL="http://127.0.0.1:${PIXIU_API_PORT:-8765}/version"
    VERSION_JSON="${STATE_DIR}/startup-version.json"
    READY=0
    ATTEMPT=0
    while [ "${ATTEMPT}" -lt 50 ]; do
        if curl --silent --show-error --fail --max-time 1 \
                --output "${VERSION_JSON}" "${VERSION_URL}" 2>/dev/null; then
            if /usr/bin/python3 - "${VERSION_JSON}" "${EXPECTED_VERSION}" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    payload = json.load(handle)
if payload.get("component") != "pixiu-memory-backend":
    raise SystemExit(1)
if payload.get("product_version") != sys.argv[2]:
    raise SystemExit(1)
PY
            then
                READY=1
                break
            fi
        fi
        ATTEMPT=$((ATTEMPT + 1))
        sleep 0.1
    done
    rm -f "${VERSION_JSON}"
    [ "${READY}" = "1" ] || {
        echo "pixiu-user-setup: backend identity/version handshake failed" >&2
        exit 4
    }
fi
