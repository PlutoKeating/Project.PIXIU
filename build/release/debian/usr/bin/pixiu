#!/bin/sh
# PIXIU 一键启动器：在当前桌面用户会话准备并启动后端，再打开控制台。
set -eu

/usr/bin/pixiu-user-setup --start

# This runs as the desktop user, so user-local Agent runtimes are discoverable.
# A strict native build must not open while its complete Agent integration is
# unavailable; generic builds retain the standalone memory-console fallback.
STRICT_FILE=/usr/share/pixiu/install-strict
STRICT=0
if [ -f "${STRICT_FILE}" ]; then
    STRICT="$(tr -d '\r\n' < "${STRICT_FILE}")"
fi
if [ "${STRICT}" = "1" ]; then
    /usr/bin/pixiu-agent-integrate --quiet
    exec /usr/bin/kylin-agent "$@"
else
    /usr/bin/pixiu-agent-integrate --quiet || true
fi

exec /usr/bin/pixiu-frontend "$@"
