+    async def _handle_probe_config_model(self, request: "web.Request") -> "web.Response":
+        auth_err = self._check_auth(request)
+        if auth_err:
+            return auth_err
+        try:
+            payload = await request.json()
+        except Exception:
+            return web.json_response(_openai_error("Invalid JSON body", code="invalid_json"), status=400)
+        if not isinstance(payload, dict):
+            return web.json_response(_openai_error("JSON object is required", code="invalid_model"), status=400)
+        row_id = str(payload.get("id") or "").strip()
+        provider = str(payload.get("provider") or "").strip().lower()
+        model = str(payload.get("model") or "").strip()
+        base_url = str(payload.get("baseUrl") or payload.get("base_url") or "").strip().rstrip("/")
+        api_key = str(payload.get("apiKey") or payload.get("api_key") or "").strip()
+        if not api_key and row_id:
+            for entry in self._read_models_file():
+                if str(entry.get("id") or "") == row_id:
+                    api_key = str(entry.get("apiKey") or "").strip()
+                    break
+        parsed = urlparse(base_url)
+        loopback = parsed.hostname in {"127.0.0.1", "::1", "localhost"}
+        if parsed.scheme not in {"http", "https"} or not parsed.hostname or parsed.username or parsed.password:
+            return web.json_response({"ok": False, "message": "API 地址无效。"})
+        if parsed.scheme != "https" and not loopback:
+            return web.json_response({"ok": False, "message": "远程模型必须使用 HTTPS。"})
+        if provider != "kylin-genai" and not api_key:
+            return web.json_response({"ok": False, "message": "该模型尚未配置 API Key。"})
+
+        def probe() -> tuple[bool, str]:
+            class NoRedirect(urllib.request.HTTPRedirectHandler):
+                def redirect_request(self, req, fp, code, msg, headers, newurl):
+                    return None
+
+            target = base_url + "/models"
+            probe_request = urllib.request.Request(target, headers={"Accept": "application/json"})
+            if api_key:
+                probe_request.add_header("Authorization", f"Bearer {api_key}")
+            try:
+                opener = urllib.request.build_opener(NoRedirect)
+                with opener.open(probe_request, timeout=15) as response:
+                    data = json.loads(response.read(2_000_000).decode("utf-8"))
+            except urllib.error.HTTPError as exc:
+                if exc.code in {401, 403}:
+                    return False, "API Key 无效、已过期或没有模型访问权限。"
+                return False, f"模型服务返回 HTTP {exc.code}。"
+            except Exception:
+                return False, "无法连接模型服务，请检查网络和 API 地址。"
+            items = data.get("data") if isinstance(data, dict) else None
+            if not isinstance(items, list):
+                return False, "模型服务返回了不兼容的模型列表。"
+            available = {str(item.get("id") or "") for item in items if isinstance(item, dict)}
+            if provider == "kylin-genai" and model == "kylin-default" and available:
+                return True, "麒灵系统云模型可用，PIXIU 将跟随系统首选模型。"
+            suffixes = {item.rsplit("/", 1)[-1] for item in available}
+            if model not in available and model.rsplit("/", 1)[-1] not in suffixes:
+                return False, "连接成功，但模型 ID 不在服务返回的可用列表中。"
+            return True, "模型连接和认证检测成功。"
+
+        ok, message = await asyncio.to_thread(probe)
+        return web.json_response({"ok": ok, "message": message})
 
