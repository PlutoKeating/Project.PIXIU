--- a/model_tools.py
+++ b/model_tools.py
@@ -34,6 +34,23 @@
 
 logger = logging.getLogger(__name__)
 
+_LEGACY_PRODUCT_NAME = re.compile(
+    r"(?i)(?<![A-Za-z0-9_])hermes(?:[ -]+agent)?(?![A-Za-z0-9_])"
+)
+
+
+def _pixiu_model_facing_schema(value: Any) -> Any:
+    """Return a schema copy whose descriptions use PIXIU product language."""
+    if isinstance(value, dict):
+        return {key: _pixiu_model_facing_schema(item) for key, item in value.items()}
+    if isinstance(value, list):
+        return [_pixiu_model_facing_schema(item) for item in value]
+    if isinstance(value, str):
+        branded = value.replace("HERMES_HOME", "PIXIU Runtime profile directory")
+        branded = branded.replace("hermes_tools", "pixiu_tools")
+        return _LEGACY_PRODUCT_NAME.sub("PIXIU", branded)
+    return value
+
 
